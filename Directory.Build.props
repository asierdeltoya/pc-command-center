<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>PC Command Center</Company>
    <Product>PC Command Center</Product>
    <Copyright>Copyright © 2026 PC Command Center</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Windows-only application: platform analyzer warnings are noise here. -->
    <NoWarn>$(NoWarn);CA1416;MVVMTK0045;CS1591</NoWarn>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <PropertyGroup>
    <MsExtVersion>10.0.13</MsExtVersion>
  </PropertyGroup>
</Project>
