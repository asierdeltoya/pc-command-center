<UserControl x:Class="PCCommandCenter.App.Views.AiAssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PCCommandCenter.App.Controls"
             xmlns:l="clr-namespace:PCCommandCenter.App.Localization"
             xmlns:vm="clr-namespace:PCCommandCenter.App.ViewModels">
    <Grid Margin="28,4,28,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <DockPanel>
            <!-- Not configured banner -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="{Binding IsConfigured, Converter={StaticResource VisibleIf}, ConverterParameter=invert}">
                <DockPanel>
                    <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource Brush.WarningSoft}">
                        <TextBlock Text="&#xE192;" Style="{StaticResource Icon}" FontSize="17" Foreground="{DynamicResource Brush.Warning}" />
                    </Border>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Primary}" Content="{l:T 'Configure AI'}" c:Ui.Glyph="&#xE713;" Command="{Binding OpenSettingsCommand}" VerticalAlignment="Center" />
                    <StackPanel Margin="14,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{l:T 'Connect the AI Assistant'}" Style="{StaticResource Text.H3}" />
                        <TextBlock Text="{l:T 'Add your Anthropic API key in Settings. It is stored encrypted on this PC and only used when you send a question.'}"
                                   Style="{StaticResource Text.Secondary}" FontSize="12.5" TextWrapping="Wrap" TextTrimming="None" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Composer -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="12" Margin="0,14,0,0">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,0,0,8" Visibility="{Binding Attachments.Count, Converter={StaticResource VisibleIf}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AttachmentItem}">
                                <Border Style="{StaticResource Chip}" Margin="0,0,8,6" Padding="10,4,4,4" ToolTip="{Binding Preview}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE723;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding Title}" FontSize="12" MaxWidth="260" />
                                        <TextBlock Text="{Binding Size}" Style="{StaticResource Text.Caption}" Margin="8,0,4,0" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource Btn.Icon}" Width="20" Height="20" FontSize="8" c:Ui.Glyph="&#xE8BB;"
                                                Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel>
                        <Grid DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="10,0,0,0">
                            <Button Style="{StaticResource Btn.Primary}" c:Ui.Glyph="&#xE724;" Content="{l:T 'Send'}" Command="{Binding SendCommand}"
                                    Visibility="{Binding IsGenerating, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" />
                            <Button Style="{StaticResource Btn.Secondary}" c:Ui.Glyph="&#xE71A;" Content="{l:T 'Stop'}" Command="{Binding StopCommand}"
                                    Visibility="{Binding IsGenerating, Converter={StaticResource VisibleIf}}" />
                        </Grid>
                        <TextBox x:Name="InputBox" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxHeight="160"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" c:Ui.Placeholder="{l:T 'Ask about your PC… (Enter to send, Shift+Enter for a new line)'}"
                                 c:Ui.EnterCommand="{Binding SendCommand}" FontSize="13.5" />
                    </DockPanel>
                    <DockPanel Margin="2,10,0,0">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"><Run Text="{Binding ModelName, Mode=OneWay}" /></TextBlock>
                        <TextBlock Text="{l:T 'Attach live data:'}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <CheckBox Content="{l:T 'System'}" IsChecked="{Binding IncludeSystem}" FontSize="12" Margin="0,0,12,0" />
                        <CheckBox Content="{l:T 'Processes'}" IsChecked="{Binding IncludeProcesses}" FontSize="12" Margin="0,0,12,0" />
                        <CheckBox Content="{l:T 'Network'}" IsChecked="{Binding IncludeNetwork}" FontSize="12" Margin="0,0,12,0" />
                        <CheckBox Content="{l:T 'Health report'}" IsChecked="{Binding IncludeHealth}" FontSize="12" Margin="0,0,12,0" />
                        <Button Style="{StaticResource Btn.Link}" Content="{l:T 'Preview data sent'}" Command="{Binding PreviewContextCommand}" VerticalAlignment="Center" FontSize="12" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Conversation -->
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <!-- Empty state -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620" Visibility="{Binding HasMessages, Converter={StaticResource VisibleIf}, ConverterParameter=invert}">
                        <Border Width="60" Height="60" CornerRadius="18" Background="{DynamicResource Brush.AccentGradient}" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE99A;" Style="{StaticResource Icon}" FontSize="26" Foreground="White" />
                        </Border>
                        <TextBlock Text="{l:T 'Your PC technical assistant'}" Style="{StaticResource Text.H2}" FontSize="18" HorizontalAlignment="Center" Margin="0,16,0,0" />
                        <TextBlock Text="{l:T 'Answers are based on live data measured on this PC. The assistant separates verified facts, hypotheses and recommendations, and never runs commands by itself.'}"
                                   Style="{StaticResource Text.Secondary}" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,20" LineHeight="19" />
                        <ItemsControl ItemsSource="{Binding Suggestions}" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Btn.Secondary}" Content="{Binding}" FontWeight="Normal" FontSize="12.5" Margin="4" Padding="12,7"
                                            Command="{Binding DataContext.UseSuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <DockPanel Visibility="{Binding HasMessages, Converter={StaticResource VisibleIf}}">
                        <DockPanel DockPanel.Dock="Top" Margin="18,12,12,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Padding="10,5" FontSize="12" c:Ui.Glyph="&#xE74D;" Content="{l:T 'New conversation'}" Command="{Binding ClearCommand}" />
                            <TextBlock Text="{l:T 'Conversation'}" Style="{StaticResource Text.H3}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" c:Ui.AutoScrollTrigger="{Binding ScrollTick}" Padding="18,6,18,18">
                            <ItemsControl ItemsSource="{Binding Messages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ChatMessage}">
                                        <Grid Margin="0,10">
                                            <!-- User bubble -->
                                            <Border x:Name="UserBubble" HorizontalAlignment="Right" MaxWidth="640" CornerRadius="14,14,4,14" Padding="14,10" Background="{DynamicResource Brush.AccentSoft}" Visibility="Collapsed">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" TextTrimming="None" FontSize="13.5" LineHeight="20" />
                                                    <ItemsControl ItemsSource="{Binding AttachmentTitles}" Margin="0,6,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Style="{StaticResource Text.Caption}"><Run Text="&#xE723;" FontFamily="{StaticResource Font.Icons}" /> <Run Text="{Binding Mode=OneWay}" /></TextBlock>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                            <!-- Assistant message -->
                                            <DockPanel x:Name="AssistantBlock">
                                                <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="9" Background="{DynamicResource Brush.AccentGradient}" VerticalAlignment="Top" Margin="0,2,12,0">
                                                    <TextBlock Text="&#xE99A;" Style="{StaticResource Icon}" FontSize="14" Foreground="White" />
                                                </Border>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsStreaming, Converter={StaticResource VisibleIf}}" Margin="0,4,0,6">
                                                        <ContentControl Style="{StaticResource Spinner}" Width="14" Height="14" />
                                                        <TextBlock Text="{l:T 'Analyzing your system…'}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" />
                                                    </StackPanel>
                                                    <c:MarkdownView Markdown="{Binding Text}"
                                                                    RunCodeCommand="{Binding DataContext.RunCodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CopyCodeCommand="{Binding DataContext.CopyCodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                    <Border Style="{StaticResource Panel.Inset}" Background="{DynamicResource Brush.DangerSoft}" BorderThickness="0" Padding="10,7" Margin="0,4,0,0"
                                                            Visibility="{Binding Error, Converter={StaticResource VisibleIf}}">
                                                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" FontSize="12.5" />
                                                    </Border>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding Footer, Converter={StaticResource VisibleIf}}">
                                                        <TextBlock Text="{Binding Footer}" Style="{StaticResource Text.Caption}" FontSize="11" VerticalAlignment="Center" />
                                                        <Button Style="{StaticResource Btn.Link}" Content="{l:T 'Copy'}" FontSize="11" Margin="10,0,0,0"
                                                                Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                <Setter TargetName="UserBubble" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="AssistantBlock" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>
        </DockPanel>

        <!-- Context preview -->
        <Border Grid.Column="1" Width="380" Margin="14,0,0,0" Style="{StaticResource Card}" Visibility="{Binding ContextPreviewOpen, Converter={StaticResource VisibleIf}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" c:Ui.Glyph="&#xE8BB;" FontSize="10" Command="{Binding ToggleContextPreviewCommand}" />
                    <StackPanel>
                        <TextBlock Text="{l:T 'Data sent to the AI'}" Style="{StaticResource Text.H3}" />
                        <TextBlock Text="{l:T 'Exactly what is attached with your next question'}" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </DockPanel>
                <TextBox Text="{Binding LastContext, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" FontFamily="{StaticResource Font.Mono}" FontSize="11"
                         VerticalScrollBarVisibility="Auto" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
