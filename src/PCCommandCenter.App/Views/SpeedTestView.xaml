<UserControl x:Class="PCCommandCenter.App.Views.SpeedTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PCCommandCenter.App.Controls"
             xmlns:l="clr-namespace:PCCommandCenter.App.Localization"
             xmlns:vm="clr-namespace:PCCommandCenter.App.ViewModels">
    <UserControl.Resources>
        <Style x:Key="Metric" TargetType="Border" BasedOn="{StaticResource Panel.Inset}">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,4,28,28">
            <c:AdaptiveGrid MinColumnWidth="460" MaxColumns="2" Gap="16">
                <!-- Internet -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Border Style="{StaticResource CardIcon}" Background="{DynamicResource Brush.AccentSoft}">
                                <TextBlock Text="&#xE701;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Chart.Rx}" />
                            </Border>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource Btn.Primary}" c:Ui.Glyph="&#xE768;" Content="{l:T 'Start test'}" Command="{Binding RunInternetCommand}"
                                        IsEnabled="{Binding AnyRunning, Converter={StaticResource Not}}" />
                                <Button Style="{StaticResource Btn.Secondary}" c:Ui.Glyph="&#xE711;" Content="{l:T 'Stop'}" Command="{Binding CancelCommand}" Margin="8,0,0,0"
                                        Visibility="{Binding NetRunning, Converter={StaticResource VisibleIf}}" />
                            </StackPanel>
                            <StackPanel Margin="12,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{l:T 'Internet speed'}" Style="{StaticResource Text.H2}" />
                                <TextBlock Style="{StaticResource Text.Caption}"><Run Text="{l:T 'Server:'}" /> <Run Text="{Binding Provider, Mode=OneWay}" /></TextBlock>
                            </StackPanel>
                        </DockPanel>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="150" Height="150" VerticalAlignment="Top">
                                <c:RingGauge Value="{Binding GaugeValue}" Thickness="10" Stroke="{DynamicResource Brush.Chart.Rx}" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center" FontSize="26" FontWeight="SemiBold" Text="{Binding Download}" Visibility="{Binding NetRunning, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" />
                                    <TextBlock HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="{Binding LiveSpeed}" Visibility="{Binding NetRunning, Converter={StaticResource VisibleIf}}" />
                                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Caption}" Text="{l:T 'Mbps download'}" Visibility="{Binding NetRunning, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" />
                                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Caption}" Text="{Binding NetPhase}" Visibility="{Binding NetRunning, Converter={StaticResource VisibleIf}}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Column="1">
                                <WrapPanel>
                                    <Border Style="{StaticResource Metric}" MinWidth="120">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Text.Overline}"><Run Text="↓ " /><Run Text="{l:T 'Download'}" /></TextBlock>
                                            <TextBlock Style="{StaticResource MetricValue}"><Run Text="{Binding Download, Mode=OneWay}" /><Run Text=" Mbps" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" /></TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Metric}" MinWidth="120">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Text.Overline}"><Run Text="↑ " /><Run Text="{l:T 'Upload'}" /></TextBlock>
                                            <TextBlock Style="{StaticResource MetricValue}"><Run Text="{Binding Upload, Mode=OneWay}" /><Run Text=" Mbps" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" /></TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Metric}" MinWidth="100">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Text.Overline}" Text="{l:T 'Latency'}" />
                                            <TextBlock Style="{StaticResource MetricValue}" FontSize="18" Text="{Binding Latency}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Metric}" MinWidth="100">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Text.Overline}" Text="{l:T 'Jitter'}" />
                                            <TextBlock Style="{StaticResource MetricValue}" FontSize="18" Text="{Binding Jitter}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Metric}" MinWidth="100" ToolTip="{l:T 'Latency while the connection is busy downloading. A big increase means bufferbloat.'}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Text.Overline}" Text="{l:T 'Under load'}" />
                                            <TextBlock Style="{StaticResource MetricValue}" FontSize="18" Text="{Binding LoadedLatency}" />
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                                <ProgressBar Value="{Binding NetProgress, Converter={x:Static c:ProgressToPercent.Instance}}" Margin="0,4,10,0" Visibility="{Binding NetRunning, Converter={StaticResource VisibleIf}}" />
                            </StackPanel>
                        </Grid>
                        <c:AreaChart Height="90" Margin="0,14,0,0" Values="{Binding LiveHistory}" Stroke="{DynamicResource Brush.Chart.Rx}" SeriesName="Mbps"
                                     Visibility="{Binding LiveHistory.Length, Converter={StaticResource VisibleIf}}" />
                        <TextBlock Text="{Binding NetServer}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0" Visibility="{Binding NetServer, Converter={StaticResource VisibleIf}}" />
                        <Border Style="{StaticResource Panel.Inset}" Padding="14,10" Margin="0,10,0,0" Visibility="{Binding NetVerdict, Converter={StaticResource VisibleIf}}">
                            <TextBlock TextWrapping="Wrap" FontSize="12.5"><Run Text="&#xE82F;" FontFamily="{StaticResource Font.Icons}" Foreground="{DynamicResource Brush.Accent}" /> <Run Text="{Binding NetVerdict, Mode=OneWay}" /></TextBlock>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Disk -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Border Style="{StaticResource CardIcon}" Background="{DynamicResource Brush.WarningSoft}">
                                <TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Chart.Disk}" />
                            </Border>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource Btn.Primary}" c:Ui.Glyph="&#xE768;" Content="{l:T 'Start benchmark'}" Command="{Binding RunDiskCommand}"
                                        IsEnabled="{Binding AnyRunning, Converter={StaticResource Not}}" />
                                <Button Style="{StaticResource Btn.Secondary}" c:Ui.Glyph="&#xE711;" Content="{l:T 'Stop'}" Command="{Binding CancelCommand}" Margin="8,0,0,0"
                                        Visibility="{Binding DiskRunning, Converter={StaticResource VisibleIf}}" />
                            </StackPanel>
                            <StackPanel Margin="12,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{l:T 'Disk speed'}" Style="{StaticResource Text.H2}" />
                                <TextBlock Text="{l:T 'Sequential and random 4K read/write'}" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <TextBlock Text="{l:T 'Drive'}" VerticalAlignment="Center" Style="{StaticResource Text.Secondary}" Margin="0,0,8,0" />
                            <ComboBox Width="190" ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" IsEnabled="{Binding AnyRunning, Converter={StaticResource Not}}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /> <Run Text="{Binding Label, Mode=OneWay}" /></TextBlock></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{l:T 'Test size'}" VerticalAlignment="Center" Style="{StaticResource Text.Secondary}" Margin="16,0,8,0" />
                            <ComboBox Width="100" ItemsSource="{x:Static vm:SpeedTestViewModel.Sizes}" SelectedItem="{Binding SelectedSize}" IsEnabled="{Binding AnyRunning, Converter={StaticResource Not}}" />
                        </StackPanel>
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding DiskRunning, Converter={StaticResource VisibleIf}}">
                            <TextBlock Text="{Binding DiskPhase}" Style="{StaticResource Text.Caption}" />
                            <ProgressBar Value="{Binding DiskProgress, Converter={x:Static c:ProgressToPercent.Instance}}" Margin="0,6,0,0" />
                        </StackPanel>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{l:T 'SEQ read'}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <ProgressBar Grid.Column="1" Value="{Binding SeqReadBar}" Height="10" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Chart.Disk}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><Run Text="{Binding SeqRead, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" /><Run Text=" MB/s" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" /></TextBlock>
                            <TextBlock Grid.Row="1" Text="{l:T 'SEQ write'}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <ProgressBar Grid.Row="1" Grid.Column="1" Value="{Binding SeqWriteBar}" Height="10" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Chart.Tx}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><Run Text="{Binding SeqWrite, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" /><Run Text=" MB/s" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" /></TextBlock>
                            <TextBlock Grid.Row="2" Text="{l:T 'RND4K read'}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <ProgressBar Grid.Row="2" Grid.Column="1" Value="{Binding RndReadBar}" Height="10" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Chart.Disk}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><Run Text="{Binding RndRead, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" /><Run Text=" MB/s" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" /></TextBlock>
                            <TextBlock Grid.Row="3" Text="{l:T 'RND4K write'}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <ProgressBar Grid.Row="3" Grid.Column="1" Value="{Binding RndWriteBar}" Height="10" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Chart.Tx}" />
                            <TextBlock Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><Run Text="{Binding RndWrite, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" /><Run Text=" MB/s" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" /></TextBlock>
                        </Grid>
                        <Border Style="{StaticResource Panel.Inset}" Padding="14,10" Margin="0,14,0,0" Visibility="{Binding DiskVerdict, Converter={StaticResource VisibleIf}}">
                            <TextBlock TextWrapping="Wrap" FontSize="12.5"><Run Text="&#xE82F;" FontFamily="{StaticResource Font.Icons}" Foreground="{DynamicResource Brush.Accent}" /> <Run Text="{Binding DiskVerdict, Mode=OneWay}" /></TextBlock>
                        </Border>
                        <TextBlock Text="{l:T 'Uses unbuffered I/O like CrystalDiskMark, so results reflect the drive and not the RAM cache. The temporary file is always deleted.'}"
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </c:AdaptiveGrid>
            <Button Style="{StaticResource Btn.Ghost}" c:Ui.Glyph="&#xE99A;" Content="{l:T 'Ask AI about these results'}" Command="{Binding AskAiCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
