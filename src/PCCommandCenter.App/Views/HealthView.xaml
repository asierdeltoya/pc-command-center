<UserControl x:Class="PCCommandCenter.App.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PCCommandCenter.App.Controls"
             xmlns:l="clr-namespace:PCCommandCenter.App.Localization"
             xmlns:vm="clr-namespace:PCCommandCenter.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,4,28,28">
            <!-- Score header -->
            <Border Style="{StaticResource Card}" Padding="26,22">
                <DockPanel>
                    <Grid Width="150" Height="150">
                        <c:RingGauge Value="{Binding Score}" Thickness="11" Stroke="{Binding Overall, Converter={StaticResource StatusBrush}}"
                                     Visibility="{Binding HasReport, Converter={StaticResource VisibleIf}}" />
                        <c:RingGauge Value="{Binding Progress, Converter={x:Static c:ProgressToPercent.Instance}}" Thickness="11" Stroke="{DynamicResource Brush.Accent}"
                                     Visibility="{Binding IsScanning, Converter={StaticResource VisibleIf}}" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" FontSize="38" FontWeight="SemiBold" FontFamily="{StaticResource Font.Display}"
                                       Text="{Binding Score}" Visibility="{Binding HasReport, Converter={StaticResource VisibleIf}}" />
                            <TextBlock HorizontalAlignment="Center" Text="/ 100" Style="{StaticResource Text.Caption}" Visibility="{Binding HasReport, Converter={StaticResource VisibleIf}}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource Btn.Primary}" Content="{l:T 'Run scan'}" c:Ui.Glyph="&#xE72C;" Command="{Binding ScanCommand}" Padding="18,9"
                                Visibility="{Binding IsScanning, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" />
                        <Button Style="{StaticResource Btn.Secondary}" Content="{l:T 'Cancel'}" Command="{Binding CancelCommand}" Padding="18,9"
                                Visibility="{Binding IsScanning, Converter={StaticResource VisibleIf}}" />
                        <Button Style="{StaticResource Btn.Ghost}" Content="{l:T 'Ask AI about this report'}" c:Ui.Glyph="&#xE99A;" Command="{Binding AskAiReportCommand}" Margin="0,8,0,0"
                                Visibility="{Binding HasReport, Converter={StaticResource VisibleIf}}" />
                        <Button Style="{StaticResource Btn.Ghost}" Content="{l:T 'Export report'}" c:Ui.Glyph="&#xEDE1;" Command="{Binding ExportReportCommand}" Margin="0,4,0,0"
                                IsEnabled="{Binding Exporting, Converter={StaticResource Not}}" ToolTip="{l:T 'Save a complete HTML report to share with a technician'}" />
                    </StackPanel>
                    <StackPanel Margin="28,0,20,0" VerticalAlignment="Center">
                        <TextBlock Text="{l:T 'SYSTEM HEALTH'}" Style="{StaticResource Text.Overline}" />
                        <TextBlock Text="{Binding ScoreLabel}" Style="{StaticResource Text.PageTitle}" FontSize="26" Margin="0,4,0,0"
                                   Visibility="{Binding IsScanning, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" />
                        <TextBlock Text="{l:T 'Scanning your system...'}" Style="{StaticResource Text.PageTitle}" FontSize="26" Margin="0,4,0,0"
                                   Visibility="{Binding IsScanning, Converter={StaticResource VisibleIf}}" />
                        <TextBlock Text="{Binding Step}" Style="{StaticResource Text.Secondary}" Margin="0,6,0,0" Visibility="{Binding IsScanning, Converter={StaticResource VisibleIf}}" />
                        <TextBlock Text="{Binding LastScan}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" Visibility="{Binding IsScanning, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0" Visibility="{Binding HasReport, Converter={StaticResource VisibleIf}}">
                            <ContentControl Style="{StaticResource StatusPill}" Tag="{x:Static c:Statuses.Critical}" Margin="0,0,8,0">
                                <TextBlock><Run Text="{Binding CriticalCount, Mode=OneWay}" /> <Run Text="{l:T 'critical findings'}" /></TextBlock>
                            </ContentControl>
                            <ContentControl Style="{StaticResource StatusPill}" Tag="{x:Static c:Statuses.Warning}" Margin="0,0,8,0">
                                <TextBlock><Run Text="{Binding WarningCount, Mode=OneWay}" /> <Run Text="{l:T 'warnings'}" /></TextBlock>
                            </ContentControl>
                            <ContentControl Style="{StaticResource StatusPill}" Tag="{x:Static c:Statuses.Info}">
                                <TextBlock><Run Text="{Binding InfoCount, Mode=OneWay}" /> <Run Text="{l:T 'notes'}" /></TextBlock>
                            </ContentControl>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Categories -->
            <TextBlock Text="{l:T 'Categories'}" Style="{StaticResource Text.H2}" Margin="2,24,0,12" Visibility="{Binding HasReport, Converter={StaticResource VisibleIf}}" />
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <c:AdaptiveGrid MinColumnWidth="290" MaxColumns="4" Gap="14" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:HealthCategoryItem}">
                        <Border Style="{StaticResource Card.Hover}" Padding="16">
                            <StackPanel>
                                <DockPanel>
                                    <Border Width="34" Height="34" CornerRadius="10" Background="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=soft}">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                    </Border>
                                    <ContentControl DockPanel.Dock="Right" Style="{StaticResource StatusPill}" Tag="{Binding Status}" Content="{Binding StatusText}" />
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.H3}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Secondary}" FontSize="12.5" Margin="0,12,0,8" TextWrapping="Wrap" TextTrimming="None" />
                                <ItemsControl ItemsSource="{Binding Checks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <TextBlock Text="•" Style="{StaticResource Text.Caption}" Margin="0,0,7,0" />
                                                <TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Findings -->
            <DockPanel Margin="2,26,0,12" Visibility="{Binding HasReport, Converter={StaticResource VisibleIf}}">
                <TextBlock Text="{l:T 'Findings'}" Style="{StaticResource Text.H2}" />
                <TextBlock Text="{l:T 'Every finding comes from a measurement on this PC. Checks that cannot be measured are reported as Not available.'}"
                           Style="{StaticResource Text.Caption}" VerticalAlignment="Bottom" Margin="12,0,0,1" />
            </DockPanel>
            <Border Style="{StaticResource Card}" Padding="24" Visibility="{Binding Issues.Count, Converter={StaticResource VisibleIf}, ConverterParameter=invert}">
                <StackPanel Orientation="Horizontal" Visibility="{Binding HasReport, Converter={StaticResource VisibleIf}}">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Success}" FontSize="18" />
                    <TextBlock Text="{l:T 'No problems were detected.'}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Issues}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:HealthIssueItem}">
                        <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
                            <DockPanel>
                                <Border Width="36" Height="36" CornerRadius="10" VerticalAlignment="Top" Background="{Binding Severity, Converter={StaticResource StatusBrush}, ConverterParameter=soft}">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{Binding Severity, Converter={StaticResource StatusBrush}}" />
                                </Border>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button Style="{StaticResource Btn.Ghost}" Padding="10,6" FontSize="12" c:Ui.Glyph="&#xE99A;" Content="{l:T 'Ask AI'}"
                                            Command="{Binding DataContext.AskAiCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource Btn.Secondary}" Padding="10,6" FontSize="12" Content="{Binding ActionText}" Margin="6,0,0,0"
                                            Visibility="{Binding HasAction, Converter={StaticResource VisibleIf}}"
                                            Command="{Binding DataContext.OpenActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </StackPanel>
                                <StackPanel Margin="14,0,0,0">
                                    <DockPanel>
                                        <TextBlock Text="{Binding Category}" Style="{StaticResource Text.Caption}" DockPanel.Dock="Right" Margin="8,0,0,0" />
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H3}" TextWrapping="Wrap" TextTrimming="None" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Secondary}" FontSize="12.5" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0" />
                                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0">
                                        <Run Text="&#xE82F;" FontFamily="{StaticResource Font.Icons}" Foreground="{DynamicResource Brush.Accent}" /> <Run Text="{Binding Recommendation, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
