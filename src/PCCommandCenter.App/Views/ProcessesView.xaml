<UserControl x:Class="PCCommandCenter.App.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PCCommandCenter.App.Controls"
             xmlns:l="clr-namespace:PCCommandCenter.App.Localization"
             xmlns:vm="clr-namespace:PCCommandCenter.App.ViewModels">
    <Grid Margin="28,4,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,14">
            <TextBox Width="300" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}" c:Ui.Glyph="&#xE721;" c:Ui.Placeholder="{l:T 'Search by name, PID, path or user'}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Paused}" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="{l:T 'Pause updates'}" FontSize="12.5" Foreground="{DynamicResource Brush.TextSecondary}" />
                </CheckBox>
                <Button Style="{StaticResource Btn.Secondary}" c:Ui.Glyph="&#xE946;" Content="{l:T 'Details'}" Command="{Binding ShowDetailsCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource Btn.Danger}" c:Ui.Glyph="&#xE711;" Content="{l:T 'End process'}" Command="{Binding KillCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Secondary}" FontSize="12.5" VerticalAlignment="Center" Margin="16,0,0,0" />
        </DockPanel>

        <!-- Process table -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6,4">
            <Grid>
                <DataGrid x:Name="Grid" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" MouseDoubleClick="Grid_MouseDoubleClick">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{l:T 'Details'}" c:Ui.Glyph="&#xE946;" Command="{Binding ShowDetailsCommand}" />
                            <MenuItem Header="{l:T 'Open file location'}" c:Ui.Glyph="&#xE838;" Command="{Binding OpenLocationCommand}" />
                            <MenuItem Header="{l:T 'Ask AI about this process'}" c:Ui.Glyph="&#xE99A;" Command="{Binding AskAiCommand}" />
                            <Separator />
                            <MenuItem Header="{l:T 'Copy name'}" c:Ui.Glyph="&#xE8C8;" Command="{Binding CopyCommand}" CommandParameter="name" />
                            <MenuItem Header="{l:T 'Copy PID'}" c:Ui.Glyph="&#xE8C8;" Command="{Binding CopyCommand}" CommandParameter="pid" />
                            <MenuItem Header="{l:T 'Copy path'}" c:Ui.Glyph="&#xE8C8;" Command="{Binding CopyCommand}" CommandParameter="path" />
                            <MenuItem Header="{l:T 'Copy all details'}" c:Ui.Glyph="&#xE8C8;" Command="{Binding CopyCommand}" CommandParameter="all" />
                            <Separator />
                            <MenuItem Header="{l:T 'End process'}" c:Ui.Glyph="&#xE711;" Command="{Binding KillCommand}" />
                            <MenuItem Header="{l:T 'End process tree'}" c:Ui.Glyph="&#xE711;" Command="{Binding KillTreeCommand}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{l:T 'Name'}" Width="2.2*" SortMemberPath="DisplayName" MinWidth="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:ProcessRow}">
                                    <DockPanel>
                                        <Grid Width="18" Height="18" Margin="0,0,10,0">
                                            <Border CornerRadius="5" Background="{DynamicResource Brush.SurfaceAlt}" />
                                            <Image Source="{Binding Icon}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                        <TextBlock DockPanel.Dock="Right" Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="11" Margin="6,0,0,0" Foreground="{DynamicResource Brush.Warning}"
                                                   ToolTip="{l:T 'Critical Windows process'}" Visibility="{Binding IsCritical, Converter={StaticResource VisibleIf}}" />
                                        <TextBlock Style="{StaticResource Cell.Text}">
                                            <Run Text="{Binding DisplayName, Mode=OneWay}" />
                                        </TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" ElementStyle="{StaticResource Cell.Muted}" />
                        <DataGridTemplateColumn Header="CPU" Width="80" SortMemberPath="Cpu" SortDirection="Descending">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:ProcessRow}">
                                    <TextBlock Text="{Binding CpuText}" Style="{StaticResource Cell.Number}" Foreground="{Binding Cpu, Converter={StaticResource LoadBrush}, ConverterParameter=Brush.Text}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:T 'Memory'}" Width="95" SortMemberPath="Ram">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:ProcessRow}">
                                    <TextBlock Text="{Binding RamText}" Style="{StaticResource Cell.Number}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:T 'Disk'}" Width="95" SortMemberPath="Disk">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:ProcessRow}">
                                    <TextBlock Text="{Binding DiskText}" Style="{StaticResource Cell.Number}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:T 'Network'}" Width="80" SortMemberPath="Connections">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="ToolTip" Value="{l:T 'Established TCP connections. Per-process bandwidth is not exposed by Windows without kernel tracing.'}" />
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:ProcessRow}">
                                    <TextBlock Style="{StaticResource Cell.Number}"><Run Text="{Binding Connections, Mode=OneWay}" /> <Run Text="conn" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11" /></TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{l:T 'User'}" Binding="{Binding User, TargetNullValue='—'}" Width="110" ElementStyle="{StaticResource Cell.Muted}" />
                        <DataGridTextColumn Header="{l:T 'Path'}" Binding="{Binding Path, TargetNullValue='—'}" Width="2*" ElementStyle="{StaticResource Cell.Muted}" />
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource VisibleIf}}">
                    <ContentControl Style="{StaticResource Spinner}" Width="28" Height="28" />
                    <TextBlock Text="{l:T 'Reading processes…'}" Style="{StaticResource Text.Secondary}" Margin="0,12,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleIf}}" />
            </Grid>
        </Border>

        <!-- Details panel -->
        <Border Grid.Row="1" Grid.Column="1" Width="340" Margin="16,0,0,0" Style="{StaticResource Card}" Visibility="{Binding DetailsOpen, Converter={StaticResource VisibleIf}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" c:Ui.Glyph="&#xE8BB;" FontSize="10" Command="{Binding CloseDetailsCommand}" />
                    <Grid Width="36" Height="36" Margin="0,0,12,0">
                        <Border CornerRadius="10" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
                        <Image Source="{Binding Selected.Icon}" Width="22" Height="22" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Selected.DisplayName}" Style="{StaticResource Text.H3}" />
                        <TextBlock Style="{StaticResource Text.Caption}"><Run Text="{Binding Selected.Name, Mode=OneWay}" /><Run Text=" · PID " /><Run Text="{Binding Selected.Pid, Mode=OneWay}" /></TextBlock>
                    </StackPanel>
                </DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button Style="{StaticResource Btn.Secondary}" HorizontalAlignment="Stretch" c:Ui.Glyph="&#xE838;" Content="{l:T 'Open file location'}" Command="{Binding OpenLocationCommand}" Margin="0,0,0,8" />
                    <Button Style="{StaticResource Btn.Secondary}" HorizontalAlignment="Stretch" c:Ui.Glyph="&#xE99A;" Content="{l:T 'Ask AI about this process'}" Command="{Binding AskAiCommand}" Margin="0,0,0,8" />
                    <Button Style="{StaticResource Btn.Danger}" HorizontalAlignment="Stretch" c:Ui.Glyph="&#xE711;" Content="{l:T 'End process'}" Command="{Binding KillCommand}" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel>
                        <StackPanel.Resources>
                            <Style x:Key="K" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                <Setter Property="Margin" Value="0,10,0,2" />
                            </Style>
                            <Style x:Key="V" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
                                <Setter Property="FontSize" Value="12.5" />
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="TextTrimming" Value="None" />
                            </Style>
                        </StackPanel.Resources>
                        <UniformGrid Columns="2">
                            <StackPanel><TextBlock Text="CPU" Style="{StaticResource K}" /><TextBlock Text="{Binding Selected.CpuText}" Style="{StaticResource V}" FontWeight="SemiBold" /></StackPanel>
                            <StackPanel><TextBlock Text="{l:T 'Memory'}" Style="{StaticResource K}" /><TextBlock Text="{Binding Selected.RamText}" Style="{StaticResource V}" FontWeight="SemiBold" /></StackPanel>
                            <StackPanel><TextBlock Text="{l:T 'Threads'}" Style="{StaticResource K}" /><TextBlock Text="{Binding Selected.Threads}" Style="{StaticResource V}" /></StackPanel>
                            <StackPanel><TextBlock Text="{l:T 'Handles'}" Style="{StaticResource K}" /><TextBlock Text="{Binding Selected.Handles}" Style="{StaticResource V}" /></StackPanel>
                        </UniformGrid>
                        <TextBlock Text="{l:T 'Company'}" Style="{StaticResource K}" />
                        <TextBlock Text="{Binding Selected.Company, TargetNullValue='—'}" Style="{StaticResource V}" />
                        <TextBlock Text="{l:T 'Product / version'}" Style="{StaticResource K}" />
                        <TextBlock Style="{StaticResource V}"><Run Text="{Binding Details.ProductName, Mode=OneWay, TargetNullValue='—'}" /> <Run Text="{Binding Details.FileVersion, Mode=OneWay}" /></TextBlock>
                        <TextBlock Text="{l:T 'Parent process'}" Style="{StaticResource K}" />
                        <TextBlock Style="{StaticResource V}"><Run Text="{Binding Details.ParentName, Mode=OneWay, TargetNullValue='—'}" /><Run Text=" (" /><Run Text="{Binding Selected.ParentPid, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                        <TextBlock Text="{l:T 'Started'}" Style="{StaticResource K}" />
                        <TextBlock Text="{Binding Selected.StartTime, StringFormat=g, TargetNullValue='—'}" Style="{StaticResource V}" />
                        <TextBlock Text="{l:T 'Priority'}" Style="{StaticResource K}" />
                        <TextBlock Text="{Binding Details.Priority, TargetNullValue='—'}" Style="{StaticResource V}" />
                        <TextBlock Text="{l:T 'User'}" Style="{StaticResource K}" />
                        <TextBlock Text="{Binding Selected.User, TargetNullValue='—'}" Style="{StaticResource V}" />
                        <TextBlock Text="{l:T 'Path'}" Style="{StaticResource K}" />
                        <TextBlock Text="{Binding Selected.Path, TargetNullValue='—'}" Style="{StaticResource V}" FontFamily="{StaticResource Font.Mono}" FontSize="11.5" />
                        <TextBlock Text="{l:T 'Command line'}" Style="{StaticResource K}" />
                        <TextBox Text="{Binding Details.CommandLine, Mode=OneWay, TargetNullValue='—'}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource Font.Mono}" FontSize="11.5" MaxHeight="140" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
