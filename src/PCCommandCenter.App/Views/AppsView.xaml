<UserControl x:Class="PCCommandCenter.App.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PCCommandCenter.App.Controls"
             xmlns:l="clr-namespace:PCCommandCenter.App.Localization"
             xmlns:vm="clr-namespace:PCCommandCenter.App.ViewModels"
             xmlns:core="clr-namespace:PCCommandCenter.Core;assembly=PCCommandCenter.Core">
    <DockPanel Margin="28,4,28,24">
        <!-- Updates -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,14">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <Border Style="{StaticResource CardIcon}" Background="{DynamicResource Brush.AccentSoft}">
                        <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Accent}" />
                    </Border>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Btn.Secondary}" c:Ui.Glyph="&#xE72C;" Content="{l:T 'Check again'}" Command="{Binding CheckUpdatesCommand}" Margin="0,0,8,0"
                                IsEnabled="{Binding CheckingUpdates, Converter={StaticResource Not}}" />
                        <Button Style="{StaticResource Btn.Primary}" c:Ui.Glyph="&#xE896;" Content="{l:T 'Update all'}" Command="{Binding UpgradeAllCommand}"
                                Visibility="{Binding Updates.Count, Converter={StaticResource VisibleIf}}" />
                    </StackPanel>
                    <StackPanel Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{l:T 'App updates'}" Style="{StaticResource Text.H2}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <ContentControl Style="{StaticResource Spinner}" Width="14" Height="14" Margin="0,0,8,0" Visibility="{Binding CheckingUpdates, Converter={StaticResource VisibleIf}}" />
                            <TextBlock Text="{Binding UpdatesStatus}" Style="{StaticResource Text.Secondary}" FontSize="12.5" TextWrapping="Wrap" TextTrimming="None" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Updates}" Margin="0,10,0,0" MaxHeight="190" Visibility="{Binding Updates.Count, Converter={StaticResource VisibleIf}}">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer></ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type core:AppUpdate}">
                            <Border Style="{StaticResource Panel.Inset}" Padding="12,7" Margin="0,3">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Padding="10,4" FontSize="12" Content="{l:T 'Update'}" c:Ui.Glyph="&#xE896;"
                                            Command="{Binding DataContext.UpgradeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <TextBlock VerticalAlignment="Center" FontSize="12.5">
                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="   " />
                                        <Run Text="{Binding Version, Mode=OneWay}" Foreground="{DynamicResource Brush.TextMuted}" />
                                        <Run Text=" → " Foreground="{DynamicResource Brush.TextMuted}" />
                                        <Run Text="{Binding Available, Mode=OneWay}" Foreground="{DynamicResource Brush.Success}" FontWeight="SemiBold" />
                                    </TextBlock>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Toolbar -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBox Width="280" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}" c:Ui.Glyph="&#xE721;" c:Ui.Placeholder="{l:T 'Search programs or publishers'}" />
            <ComboBox Width="160" Margin="10,0,0,0" ItemsSource="{x:Static vm:AppsViewModel.Sorts}" SelectedItem="{Binding Sort}">
                <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource Tr}}" /></DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <CheckBox Content="{l:T 'Only with updates'}" IsChecked="{Binding OnlyUpdates}" Margin="14,0,0,0" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Btn.Ghost}" c:Ui.Glyph="&#xE713;" Content="{l:T 'Windows apps settings'}" Command="{Binding OpenWindowsAppsCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource Btn.Secondary}" c:Ui.Glyph="&#xE72C;" Content="{l:T 'Refresh'}" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Summary}" Style="{StaticResource Text.Caption}" Margin="4,8,0,0" />
        <Grid>
            <Border Style="{StaticResource Card}" Padding="6,4">
                <DataGrid ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" RowHeight="42" CanUserSortColumns="False">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{l:T 'Update'}" c:Ui.Glyph="&#xE896;" Command="{Binding UpgradeItemCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{l:T 'Open install folder'}" c:Ui.Glyph="&#xE838;" Command="{Binding OpenLocationCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{l:T 'Search the web'}" c:Ui.Glyph="&#xE774;" Command="{Binding SearchWebCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem Header="{l:T 'Uninstall…'}" c:Ui.Glyph="&#xE74D;" Command="{Binding UninstallCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{l:T 'Program'}" Width="2.4*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:AppItem}">
                                    <DockPanel VerticalAlignment="Center">
                                        <Grid Width="24" Height="24" Margin="4,0,10,0">
                                            <Border CornerRadius="6" Background="{DynamicResource Brush.SurfaceAlt}" />
                                            <TextBlock Text="&#xE7B8;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" />
                                            <Image Source="{Binding Icon}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="{DynamicResource Brush.SuccessSoft}" BorderThickness="0" Margin="8,0,6,0"
                                                Visibility="{Binding HasUpdate, Converter={StaticResource VisibleIf}}">
                                            <TextBlock Text="{l:T 'Update available'}" FontSize="10.5" Foreground="{DynamicResource Brush.Success}" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{l:T 'Publisher'}" Binding="{Binding Publisher}" Width="1.4*" ElementStyle="{StaticResource Cell.Muted}" />
                        <DataGridTextColumn Header="{l:T 'Version'}" Binding="{Binding Version}" Width="120" ElementStyle="{StaticResource Cell.Mono}" />
                        <DataGridTextColumn Header="{l:T 'Size'}" Binding="{Binding SizeText}" Width="90" ElementStyle="{StaticResource Cell.Muted}" />
                        <DataGridTextColumn Header="{l:T 'Installed'}" Binding="{Binding InstalledText}" Width="100" ElementStyle="{StaticResource Cell.Muted}" />
                        <DataGridTemplateColumn Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:AppItem}">
                                    <Button Style="{StaticResource Btn.Ghost}" Padding="10,4" FontSize="12" Content="{l:T 'Uninstall'}" HorizontalAlignment="Right" Margin="0,0,6,0"
                                            Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource VisibleIf}}">
                <ContentControl Style="{StaticResource Spinner}" Width="30" Height="30" />
                <TextBlock Text="{l:T 'Reading installed programs…'}" Style="{StaticResource Text.Secondary}" Margin="0,14,0,0" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
