<UserControl x:Class="PCCommandCenter.App.Views.SecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PCCommandCenter.App.Controls"
             xmlns:l="clr-namespace:PCCommandCenter.App.Localization"
             xmlns:vm="clr-namespace:PCCommandCenter.App.ViewModels">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource VisibleIf}}">
            <ContentControl Style="{StaticResource Spinner}" Width="30" Height="30" />
            <TextBlock Text="{l:T 'Checking security settings…'}" Style="{StaticResource Text.Secondary}" Margin="0,14,0,0" HorizontalAlignment="Center" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsBusy, Converter={StaticResource VisibleIf}, ConverterParameter=invert}">
            <StackPanel Margin="28,4,28,28">
                <Border Style="{StaticResource Card}" Padding="24,20">
                    <DockPanel>
                        <Border Width="64" Height="64" CornerRadius="20" Background="{Binding Overall, Converter={StaticResource StatusBrush}, ConverterParameter=soft}">
                            <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="30" Foreground="{Binding Overall, Converter={StaticResource StatusBrush}}" />
                        </Border>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Btn.Ghost}" c:Ui.Glyph="&#xE99A;" Content="{l:T 'Ask AI'}" Command="{Binding AskAiCommand}" Margin="0,0,6,0" />
                            <Button Style="{StaticResource Btn.Secondary}" c:Ui.Glyph="&#xE72C;" Content="{l:T 'Refresh'}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Btn.Secondary}" c:Ui.Glyph="&#xE721;" Content="{l:T 'Quick scan'}" Command="{Binding QuickScanCommand}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Btn.Primary}" c:Ui.Glyph="&#xE8A7;" Content="{l:T 'Windows Security'}" Command="{Binding OpenWindowsSecurityCommand}" />
                        </StackPanel>
                        <StackPanel Margin="20,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Headline}" Style="{StaticResource Text.PageTitle}" FontSize="22" TextWrapping="Wrap" TextTrimming="None" />
                            <TextBlock Text="{Binding Subline}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Checks}" Margin="0,16,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><c:AdaptiveGrid MinColumnWidth="330" MaxColumns="3" Gap="12" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SecurityItem}">
                            <Border Style="{StaticResource Card.Hover}" Padding="16,14">
                                <DockPanel>
                                    <Button DockPanel.Dock="Bottom" Style="{StaticResource Btn.Link}" HorizontalAlignment="Left" Margin="48,10,0,0" FontSize="12"
                                            Content="{l:T 'Open settings →'}" Visibility="{Binding CanOpen, Converter={StaticResource VisibleIf}}"
                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="10" VerticalAlignment="Top" Background="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=soft}">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                    </Border>
                                    <StackPanel Margin="12,0,0,0">
                                        <DockPanel>
                                            <ContentControl DockPanel.Dock="Right" Style="{StaticResource StatusPill}" Tag="{Binding Status}" Content="{Binding StatusText}" VerticalAlignment="Top" />
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H3}" TextWrapping="Wrap" TextTrimming="None" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Value}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,0"
                                                   Visibility="{Binding Detail, Converter={StaticResource VisibleIf}}" />
                                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource Brush.TextSecondary}"
                                                   Visibility="{Binding Recommendation, Converter={StaticResource VisibleIf}}">
                                            <Run Text="&#xE82F;" FontFamily="{StaticResource Font.Icons}" Foreground="{DynamicResource Brush.Accent}" /> <Run Text="{Binding Recommendation, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" Margin="2,12,0,0" Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleIf}}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
