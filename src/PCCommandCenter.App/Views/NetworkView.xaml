<UserControl x:Class="PCCommandCenter.App.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PCCommandCenter.App.Controls"
             xmlns:l="clr-namespace:PCCommandCenter.App.Localization"
             xmlns:vm="clr-namespace:PCCommandCenter.App.ViewModels"
             xmlns:core="clr-namespace:PCCommandCenter.Core;assembly=PCCommandCenter.Core">
    <UserControl.Resources>
        <Style x:Key="StatBox" TargetType="Border" BasedOn="{StaticResource Panel.Inset}">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style x:Key="TabPanel" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="28,4,28,24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" c:Ui.Glyph="&#xE99A;" Content="{l:T 'Send to AI'}" Command="{Binding SendToAiCommand}" />
            <ListBox x:Name="Tabs" Style="{StaticResource Segmented}" ItemsSource="{x:Static vm:NetworkViewModel.Tabs}" SelectedIndex="{Binding SelectedTab}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource Tr}}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Grid>
            <!-- ═════════ Ping ═════════ -->
            <Grid x:Name="PingTab" Style="{StaticResource TabPanel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding StartPingCommand}" MinWidth="110" Margin="10,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
                                    <Setter Property="Content" Value="{l:T 'Start'}" />
                                    <Setter Property="c:Ui.Glyph" Value="&#xE768;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PingRunning}" Value="True">
                                            <Setter Property="Content" Value="{l:T 'Stop'}" />
                                            <Setter Property="c:Ui.Glyph" Value="&#xE71A;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <ComboBox DockPanel.Dock="Right" Width="90" ItemsSource="{x:Static vm:NetworkViewModel.PingCounts}" SelectedItem="{Binding PingCount}" ToolTip="{l:T 'Number of probes'}" Margin="10,0,0,0" />
                        <TextBox Text="{Binding PingHost, UpdateSourceTrigger=PropertyChanged}" c:Ui.Glyph="&#xE968;" c:Ui.Placeholder="{l:T 'IP address or domain'}"
                                 c:Ui.EnterCommand="{Binding StartPingCommand}" />
                    </DockPanel>
                </Border>
                <UniformGrid Grid.Row="1" Columns="7" Margin="0,14,0,14">
                    <Border Style="{StaticResource StatBox}"><StackPanel><TextBlock Text="{l:T 'Sent'}" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding PingSent}" Style="{StaticResource Text.MetricSmall}" /></StackPanel></Border>
                    <Border Style="{StaticResource StatBox}"><StackPanel><TextBlock Text="{l:T 'Received'}" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding PingReceived}" Style="{StaticResource Text.MetricSmall}" /></StackPanel></Border>
                    <Border Style="{StaticResource StatBox}"><StackPanel><TextBlock Text="{l:T 'Packet loss'}" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding PingLoss}" Style="{StaticResource Text.MetricSmall}" /></StackPanel></Border>
                    <Border Style="{StaticResource StatBox}"><StackPanel><TextBlock Text="{l:T 'Minimum'}" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding PingMin}" Style="{StaticResource Text.MetricSmall}" /></StackPanel></Border>
                    <Border Style="{StaticResource StatBox}"><StackPanel><TextBlock Text="{l:T 'Average'}" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding PingAvg}" Style="{StaticResource Text.MetricSmall}" Foreground="{DynamicResource Brush.Accent}" /></StackPanel></Border>
                    <Border Style="{StaticResource StatBox}"><StackPanel><TextBlock Text="{l:T 'Maximum'}" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding PingMax}" Style="{StaticResource Text.MetricSmall}" /></StackPanel></Border>
                    <Border Style="{StaticResource StatBox}" Margin="0"><StackPanel><TextBlock Text="{l:T 'Jitter'}" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding PingJitter}" Style="{StaticResource Text.MetricSmall}" /></StackPanel></Border>
                </UniformGrid>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="{Binding PingResolved}" Style="{StaticResource Text.Caption}" DockPanel.Dock="Right" />
                                <TextBlock Text="{l:T 'Round-trip time per probe'}" Style="{StaticResource Text.H3}" />
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding PingError}" Foreground="{DynamicResource Brush.Danger}" Visibility="{Binding PingError, Converter={StaticResource VisibleIf}}" Margin="0,0,0,8" />
                            <c:BarChart Values="{Binding PingValues}" Fill="{DynamicResource Brush.Accent}" Slots="50" MinHeight="160" />
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="14,0,0,0" Padding="8">
                        <ListBox ItemsSource="{Binding PingProbes}" Style="{StaticResource PlainList}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type core:PingProbe}">
                                    <DockPanel Margin="10,6">
                                        <Ellipse Width="7" Height="7" Margin="0,0,10,0" Fill="{Binding Success, Converter={StaticResource StatusBrush}}" />
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}"><Run Text="TTL " /><Run Text="{Binding Ttl, Mode=OneWay, TargetNullValue='—'}" /></TextBlock>
                                        <TextBlock Style="{StaticResource Text.Mono}"><Run Text="#" /><Run Text="{Binding Sequence, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding RoundtripMs, Mode=OneWay, StringFormat={}{0} ms, TargetNullValue='—'}" /><Run Text="  " /><Run Text="{Binding Status, Mode=OneWay, Converter={StaticResource Tr}}" Foreground="{DynamicResource Brush.TextMuted}" /></TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Grid>

            <!-- ═════════ DNS ═════════ -->
            <Grid x:Name="DnsTab" Style="{StaticResource TabPanel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Primary}" c:Ui.Glyph="&#xE721;" Content="{l:T 'Resolve'}" Command="{Binding LookupCommand}" Margin="10,0,0,0" MinWidth="110" />
                            <TextBox DockPanel.Dock="Right" Width="150" Margin="10,0,0,0" Text="{Binding CustomDnsServer, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="{l:T 'Server IP'}"
                                     Visibility="{Binding IsCustomDns, Converter={StaticResource VisibleIf}}" />
                            <ComboBox DockPanel.Dock="Right" Width="200" Margin="10,0,0,0" ItemsSource="{x:Static vm:NetworkViewModel.DnsServers}" SelectedItem="{Binding DnsServer}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource Tr}}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBox Text="{Binding DnsQuery, UpdateSourceTrigger=PropertyChanged}" c:Ui.Glyph="&#xE774;" c:Ui.Placeholder="{l:T 'Domain name (or IP for PTR)'}" c:Ui.EnterCommand="{Binding LookupCommand}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding DnsTypes}" Margin="0,14,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DnsTypeOption}">
                                    <CheckBox Content="{Binding Type}" IsChecked="{Binding IsChecked}" Margin="0,0,18,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,14,0,10" Visibility="{Binding DnsHasResult, Converter={StaticResource VisibleIf}}">
                    <TextBlock Style="{StaticResource Text.Secondary}"><Run Text="{l:T 'Server'}" />: <Run Text="{Binding DnsServerUsed, Mode=OneWay}" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold" /></TextBlock>
                    <TextBlock Style="{StaticResource Text.Secondary}" Margin="24,0,0,0"><Run Text="{l:T 'Response time'}" />: <Run Text="{Binding DnsElapsed, Mode=OneWay}" Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold" /></TextBlock>
                    <TextBlock Style="{StaticResource Text.Secondary}" Margin="24,0,0,0"><Run Text="{Binding DnsRecords.Count, Mode=OneWay}" /> <Run Text="{l:T 'records'}" /></TextBlock>
                    <ContentControl Style="{StaticResource Spinner}" Margin="16,0,0,0" Width="16" Height="16" Visibility="{Binding DnsRunning, Converter={StaticResource VisibleIf}}" />
                </StackPanel>
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6,4">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding DnsErrors}" Foreground="{DynamicResource Brush.Warning}" Margin="12,8" TextWrapping="Wrap"
                                   Visibility="{Binding DnsErrors, Converter={StaticResource VisibleIf}}" />
                        <DataGrid ItemsSource="{Binding DnsRecords}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{l:T 'Type'}" Binding="{Binding Type}" Width="80" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="{l:T 'Name'}" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource Cell.Muted}" />
                                <DataGridTextColumn Header="{l:T 'Value'}" Binding="{Binding Data}" Width="2*" ElementStyle="{StaticResource Cell.Mono}" />
                                <DataGridTextColumn Header="TTL" Binding="{Binding Ttl}" Width="80" ElementStyle="{StaticResource Cell.Muted}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ═════════ Traceroute ═════════ -->
            <Grid x:Name="TraceTab" Style="{StaticResource TabPanel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding TraceCommand}" MinWidth="120" Margin="10,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
                                    <Setter Property="Content" Value="{l:T 'Trace route'}" />
                                    <Setter Property="c:Ui.Glyph" Value="&#xE768;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TraceRunning}" Value="True">
                                            <Setter Property="Content" Value="{l:T 'Stop'}" />
                                            <Setter Property="c:Ui.Glyph" Value="&#xE71A;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TraceStatus}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="14,0,4,0" />
                        <TextBox Text="{Binding TraceHost, UpdateSourceTrigger=PropertyChanged}" c:Ui.Glyph="&#xE81E;" c:Ui.Placeholder="{l:T 'Destination host'}" c:Ui.EnterCommand="{Binding TraceCommand}" />
                    </DockPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="20,14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Hops}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:HopItem}">
                                    <Grid Height="46">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="2.2*" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <!-- timeline rail -->
                                        <Rectangle Width="2" Fill="{DynamicResource Brush.Border}" HorizontalAlignment="Center" />
                                        <Border x:Name="Node" Width="26" Height="26" CornerRadius="13" Background="{DynamicResource Brush.SurfaceAlt}" BorderThickness="2" BorderBrush="{DynamicResource Brush.Accent}">
                                            <TextBlock Text="{Binding Hop}" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,10,0">
                                            <TextBlock Text="{Binding Address}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" />
                                            <TextBlock Text="{Binding HostName}" Style="{StaticResource Text.Caption}" Visibility="{Binding HostName, Converter={StaticResource VisibleIf}}" />
                                        </StackPanel>
                                        <Grid Grid.Column="2" VerticalAlignment="Center" Height="8">
                                            <Border CornerRadius="4" Background="{DynamicResource Brush.Track}" />
                                            <Border x:Name="Bar" CornerRadius="4" Background="{DynamicResource Brush.Accent}" RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding BarFraction}" />
                                                </Border.RenderTransform>
                                            </Border>
                                        </Grid>
                                        <TextBlock Grid.Column="3" Text="{Binding RttText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsTimeout}" Value="True">
                                            <Setter TargetName="Node" Property="BorderBrush" Value="{DynamicResource Brush.TextMuted}" />
                                            <Setter TargetName="Node" Property="Opacity" Value="0.6" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDestination}" Value="True">
                                            <Setter TargetName="Node" Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
                                            <Setter TargetName="Node" Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
                                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.Success}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ═════════ Interfaces ═════════ -->
            <Grid x:Name="InterfacesTab" Style="{StaticResource TabPanel}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Secondary}" c:Ui.Glyph="&#xE72C;" Content="{l:T 'Refresh'}" Command="{Binding RefreshInterfacesCommand}" />
                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ShowInactive}" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="{l:T 'Show disconnected adapters'}" Foreground="{DynamicResource Brush.TextSecondary}" />
                        </CheckBox>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Interfaces}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><c:AdaptiveGrid MinColumnWidth="420" MaxColumns="3" Gap="14" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:InterfaceItem}">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <DockPanel>
                                                <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource Brush.InfoSoft}">
                                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Info}" />
                                                </Border>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Style="{StaticResource Chip}" Margin="0,0,6,0" Visibility="{Binding Info.IsDefaultRoute, Converter={StaticResource VisibleIf}}" Background="{DynamicResource Brush.AccentSoft}" BorderThickness="0">
                                                        <TextBlock Text="{l:T 'Default route'}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" />
                                                    </Border>
                                                    <ContentControl Style="{StaticResource StatusPill}" Tag="{Binding Info.Status}" Content="{Binding Info.Status, Converter={StaticResource Tr}}" />
                                                </StackPanel>
                                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Info.Name}" Style="{StaticResource Text.H3}" />
                                                    <TextBlock Text="{Binding Info.Description}" Style="{StaticResource Text.Caption}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <Grid Margin="0,14,0,0">
                                                <Grid.Resources>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
                                                        <Setter Property="FontSize" Value="12.5" />
                                                        <Setter Property="Margin" Value="0,3" />
                                                        <Setter Property="TextWrapping" Value="Wrap" />
                                                        <Setter Property="TextTrimming" Value="None" />
                                                    </Style>
                                                </Grid.Resources>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{l:T 'Type'}" Foreground="{DynamicResource Brush.TextMuted}" />
                                                    <TextBlock Text="{l:T 'Speed'}" Foreground="{DynamicResource Brush.TextMuted}" />
                                                    <TextBlock Text="MAC" Foreground="{DynamicResource Brush.TextMuted}" />
                                                    <TextBlock Text="IPv4" Foreground="{DynamicResource Brush.TextMuted}" />
                                                    <TextBlock Text="{l:T 'Gateway'}" Foreground="{DynamicResource Brush.TextMuted}" />
                                                    <TextBlock Text="DNS" Foreground="{DynamicResource Brush.TextMuted}" />
                                                    <TextBlock Text="DHCP" Foreground="{DynamicResource Brush.TextMuted}" />
                                                    <TextBlock Text="MTU" Foreground="{DynamicResource Brush.TextMuted}" />
                                                    <TextBlock Text="{l:T 'Traffic'}" Foreground="{DynamicResource Brush.TextMuted}" />
                                                    <TextBlock Text="IPv6" Foreground="{DynamicResource Brush.TextMuted}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Info.Type}" />
                                                    <TextBlock Text="{Binding Speed}" />
                                                    <TextBlock Text="{Binding Info.Mac}" FontFamily="{StaticResource Font.Mono}" FontSize="12" />
                                                    <TextBlock Text="{Binding IPv4}" FontFamily="{StaticResource Font.Mono}" FontSize="12" />
                                                    <TextBlock Text="{Binding Gateway}" FontFamily="{StaticResource Font.Mono}" FontSize="12" />
                                                    <TextBlock Text="{Binding Dns}" FontFamily="{StaticResource Font.Mono}" FontSize="12" />
                                                    <TextBlock Text="{Binding Dhcp}" />
                                                    <TextBlock Text="{Binding Mtu}" />
                                                    <TextBlock Text="{Binding Traffic}" />
                                                    <TextBlock Text="{Binding IPv6}" FontFamily="{StaticResource Font.Mono}" FontSize="11.5" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Grid>

            <!-- ═════════ Connections ═════════ -->
            <Grid x:Name="ConnectionsTab" Style="{StaticResource TabPanel}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBox Width="280" Text="{Binding ConnectionFilter, UpdateSourceTrigger=PropertyChanged, Delay=150}" c:Ui.Glyph="&#xE721;" c:Ui.Placeholder="{l:T 'Filter by process, IP, port or PID'}" />
                        <ComboBox Width="140" Margin="10,0,0,0" ItemsSource="{x:Static vm:NetworkViewModel.StateFilters}" SelectedItem="{Binding StateFilter}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Converter={StaticResource Tr}}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <CheckBox Content="UDP" IsChecked="{Binding IncludeUdp}" Margin="14,0,0,0" VerticalAlignment="Center" />
                        <CheckBox Content="{l:T 'Auto-refresh'}" IsChecked="{Binding AutoRefreshConnections}" Margin="14,0,0,0" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Secondary}" c:Ui.Glyph="&#xE72C;" Content="{l:T 'Refresh'}" Command="{Binding RefreshConnectionsCommand}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding ConnectionSummary}" Style="{StaticResource Text.Secondary}" FontSize="12.5" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0" />
                    </DockPanel>
                    <Border Style="{StaticResource Card}" Padding="6,4">
                        <DataGrid ItemsSource="{Binding ConnectionsView}" x:Name="ConnGrid">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{l:T 'Copy'}" c:Ui.Glyph="&#xE8C8;" Command="{Binding CopyConnectionCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="{l:T 'Show process'}" c:Ui.Glyph="&#xE9F5;" Command="{Binding ShowProcessCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{l:T 'Process'}" Binding="{Binding ProcessName}" Width="1.4*" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" ElementStyle="{StaticResource Cell.Muted}" />
                                <DataGridTextColumn Header="{l:T 'Protocol'}" Binding="{Binding Protocol}" Width="80" ElementStyle="{StaticResource Cell.Muted}" />
                                <DataGridTextColumn Header="{l:T 'Local IP'}" Binding="{Binding LocalAddress}" Width="1.3*" ElementStyle="{StaticResource Cell.Mono}" />
                                <DataGridTextColumn Header="{l:T 'Local port'}" Binding="{Binding LocalPort}" Width="85" ElementStyle="{StaticResource Cell.Mono}" />
                                <DataGridTextColumn Header="{l:T 'Remote IP'}" Binding="{Binding RemoteAddress}" Width="1.3*" ElementStyle="{StaticResource Cell.Mono}" />
                                <DataGridTextColumn Header="{l:T 'Remote port'}" Binding="{Binding RemotePort}" Width="95" ElementStyle="{StaticResource Cell.Mono}" />
                                <DataGridTemplateColumn Header="{l:T 'State'}" Width="120" SortMemberPath="State">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type core:ConnectionInfo}">
                                            <ContentControl Style="{StaticResource StatusPill}" Tag="{Binding State}" Content="{Binding State, Converter={StaticResource Tr}}" HorizontalAlignment="Left" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </Grid>

            <!-- ═════════ ARP ═════════ -->
            <Grid x:Name="ArpTab" Style="{StaticResource TabPanel}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Secondary}" c:Ui.Glyph="&#xE72C;" Content="{l:T 'Refresh'}" Command="{Binding RefreshArpCommand}" />
                        <TextBlock Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Text="{l:T 'IPv4 neighbor cache (IP address to MAC address resolution) maintained by Windows.'}" />
                    </DockPanel>
                    <Border Style="{StaticResource Card}" Padding="6,4">
                        <DataGrid ItemsSource="{Binding Arp}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{l:T 'IP address'}" Binding="{Binding IpAddress}" Width="*" ElementStyle="{StaticResource Cell.Mono}" />
                                <DataGridTextColumn Header="{l:T 'MAC address'}" Binding="{Binding MacAddress}" Width="*" ElementStyle="{StaticResource Cell.Mono}" />
                                <DataGridTextColumn Header="{l:T 'Type'}" Binding="{Binding Type, Converter={StaticResource Tr}}" Width="120" ElementStyle="{StaticResource Cell.Muted}" />
                                <DataGridTextColumn Header="{l:T 'Interface'}" Binding="{Binding InterfaceName}" Width="*" ElementStyle="{StaticResource Cell.Muted}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
