<UserControl x:Class="PCCommandCenter.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PCCommandCenter.App.Controls"
             xmlns:l="clr-namespace:PCCommandCenter.App.Localization"
             xmlns:vm="clr-namespace:PCCommandCenter.App.ViewModels">
    <UserControl.Resources>
        <!-- KPI tile -->
        <Style x:Key="Kpi" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Style="{StaticResource Card}" Padding="16,14">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Stat" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Loading state until the first sample arrives -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasData, Converter={StaticResource VisibleIf}, ConverterParameter=invert}">
            <ContentControl Style="{StaticResource Spinner}" Width="30" Height="30" />
            <TextBlock Text="{l:T 'Collecting live telemetry…'}" Style="{StaticResource Text.Secondary}" Margin="0,14,0,0" HorizontalAlignment="Center" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasData, Converter={StaticResource VisibleIf}}">
            <StackPanel Margin="28,4,28,28">

                <!-- Health banner -->
                <Border CornerRadius="14" Padding="20,16" Margin="0,0,0,14" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource Color.Accent}" Offset="-1.6" />
                            <GradientStop Color="Transparent" Offset="0.75" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <Grid Width="52" Height="52">
                            <c:RingGauge Value="{Binding HealthScore, TargetNullValue=0}" Thickness="5" Stroke="{DynamicResource Brush.Success}" />
                            <TextBlock Text="{Binding HealthScore, TargetNullValue='—'}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Btn.Secondary}" Content="{l:T 'Ask AI'}" c:Ui.Glyph="&#xE99A;" Command="{Binding OpenCommand}" CommandParameter="Ai" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Btn.Primary}" Content="{l:T 'Run health scan'}" c:Ui.Glyph="&#xE95E;" Command="{Binding RunScanCommand}" />
                        </StackPanel>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Greeting}" Style="{StaticResource Text.H2}" FontSize="16" />
                            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,3,0,0">
                                <Run Text="{l:T 'System health:'}" /> <Run Text="{Binding HealthLabel, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                                <Run Text="  ·  " /><Run Text="{Binding CpuName, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{l:T 'up'}" /> <Run Text="{Binding Uptime, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- KPI row -->
                <c:AdaptiveGrid MinColumnWidth="190" MaxColumns="5" Gap="14">
                    <!-- CPU -->
                    <Button Style="{StaticResource Kpi}" Command="{Binding OpenCommand}" CommandParameter="Processes" ToolTip="{l:T 'Open Processes'}">
                        <DockPanel>
                            <Grid Width="58" Height="58">
                                <c:RingGauge Value="{Binding CpuUsage}" Thickness="6" Stroke="{DynamicResource Brush.Chart.Cpu}" />
                                <TextBlock Text="&#xE950;" Style="{StaticResource Icon}" FontSize="17" Foreground="{DynamicResource Brush.Chart.Cpu}" />
                            </Grid>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="CPU" Style="{StaticResource Text.Overline}" />
                                <TextBlock Text="{Binding CpuUsage, StringFormat={}{0:0}%}" Style="{StaticResource Text.Metric}" FontSize="22" />
                                <TextBlock Text="{Binding CpuFrequency}" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                        </DockPanel>
                    </Button>
                    <!-- GPU -->
                    <Button Style="{StaticResource Kpi}" Command="{Binding OpenCommand}" CommandParameter="Processes">
                        <DockPanel>
                            <Grid Width="58" Height="58">
                                <c:RingGauge Value="{Binding GpuUsage}" IsAvailable="{Binding GpuAvailable}" Thickness="6" Stroke="{DynamicResource Brush.Chart.Gpu}" />
                                <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="17" Foreground="{DynamicResource Brush.Chart.Gpu}" />
                            </Grid>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="GPU" Style="{StaticResource Text.Overline}" />
                                <TextBlock Text="{Binding GpuUsage, StringFormat={}{0:0}%}" Style="{StaticResource Text.Metric}" FontSize="22" />
                                <TextBlock Text="{Binding GpuTemperature}" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                        </DockPanel>
                    </Button>
                    <!-- RAM -->
                    <Button Style="{StaticResource Kpi}" Command="{Binding OpenCommand}" CommandParameter="Processes">
                        <DockPanel>
                            <Grid Width="58" Height="58">
                                <c:RingGauge Value="{Binding MemPercent}" Thickness="6" Stroke="{DynamicResource Brush.Chart.Ram}" />
                                <TextBlock Text="&#xE964;" Style="{StaticResource Icon}" FontSize="17" Foreground="{DynamicResource Brush.Chart.Ram}" />
                            </Grid>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{l:T 'MEMORY'}" Style="{StaticResource Text.Overline}" />
                                <TextBlock Text="{Binding MemPercent, StringFormat={}{0:0}%}" Style="{StaticResource Text.Metric}" FontSize="22" />
                                <TextBlock Style="{StaticResource Text.Caption}">
                                    <Run Text="{Binding MemUsed, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding MemTotal, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                    <!-- Disk -->
                    <Button Style="{StaticResource Kpi}" Command="{Binding OpenCommand}" CommandParameter="Storage">
                        <DockPanel>
                            <Grid Width="58" Height="58">
                                <c:RingGauge Value="{Binding DiskActive}" Thickness="6" Stroke="{DynamicResource Brush.Chart.Disk}" />
                                <TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" FontSize="17" Foreground="{DynamicResource Brush.Chart.Disk}" />
                            </Grid>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{l:T 'DISK ACTIVITY'}" Style="{StaticResource Text.Overline}" />
                                <TextBlock Text="{Binding DiskActive, StringFormat={}{0:0}%}" Style="{StaticResource Text.Metric}" FontSize="22" />
                                <TextBlock Style="{StaticResource Text.Caption}"><Run Text="R " /><Run Text="{Binding DiskRead, Mode=OneWay}" /></TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                    <!-- Network -->
                    <Button Style="{StaticResource Kpi}" Command="{Binding OpenCommand}" CommandParameter="Network">
                        <DockPanel>
                            <Grid Width="58" Height="58">
                                <c:RingGauge Value="{Binding LatencyGauge}" Thickness="6" Stroke="{DynamicResource Brush.Chart.Rx}" />
                                <TextBlock Text="&#xE968;" Style="{StaticResource Icon}" FontSize="17" Foreground="{DynamicResource Brush.Chart.Rx}" />
                            </Grid>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{l:T 'LATENCY'}" Style="{StaticResource Text.Overline}" />
                                <TextBlock Text="{Binding Latency}" Style="{StaticResource Text.Metric}" FontSize="22" />
                                <TextBlock Text="{Binding NetStateText}" Style="{StaticResource Text.Caption}" Foreground="{Binding NetState, Converter={StaticResource StatusBrush}}" />
                            </StackPanel>
                        </DockPanel>
                    </Button>
                </c:AdaptiveGrid>

                <!-- CPU -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <DockPanel>
                            <Border Style="{StaticResource CardIcon}" Background="{DynamicResource Brush.AccentSoft}">
                                <TextBlock Text="&#xE950;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Chart.Cpu}" />
                            </Border>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <ContentControl Style="{StaticResource StatusPill}" Tag="{Binding CpuThrottleStatus}" Content="{Binding CpuThrottle}" ToolTip="{l:T 'Share of nominal performance Windows reports the CPU can currently deliver (power, thermal or firmware limits)'}" />
                            </StackPanel>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{l:T 'Processor'}" Style="{StaticResource Text.H2}" />
                                <TextBlock Style="{StaticResource Text.Caption}"><Run Text="{Binding CpuName, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding CpuTopology, Mode=OneWay}" /></TextBlock>
                            </StackPanel>
                        </DockPanel>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="300" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="160" />
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <TextBlock Text="{Binding CpuUsage, StringFormat={}{0:0.0}%}" Style="{StaticResource Text.Metric}" />
                                    <TextBlock Text="{l:T 'utilization · last 5 minutes'}" Style="{StaticResource Text.Caption}" VerticalAlignment="Bottom" Margin="10,0,0,6" />
                                </DockPanel>
                                <c:AreaChart Grid.Row="1" Values="{Binding CpuHistory}" Maximum="100" Stroke="{DynamicResource Brush.Chart.Cpu}" Format="percent" Margin="0,8,0,0" SeriesName="CPU" />
                            </Grid>
                            <c:AdaptiveGrid Grid.Column="1" MinColumnWidth="130" MaxColumns="2" Gap="10" Margin="24,4,0,0">
                                <StackPanel Style="{StaticResource Stat}">
                                    <TextBlock Text="{l:T 'Frequency'}" Style="{StaticResource StatLabel}" />
                                    <TextBlock Text="{Binding CpuFrequency}" Style="{StaticResource StatValue}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Stat}" ToolTip="{Binding CpuTemperatureSource}">
                                    <TextBlock Text="{l:T 'Temperature'}" Style="{StaticResource StatLabel}" />
                                    <TextBlock Text="{Binding CpuTemperature}" Style="{StaticResource StatValue}" />
                                    <TextBlock Text="{Binding CpuTemperatureSource}" Style="{StaticResource Text.Caption}" FontSize="10.5" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Stat}" ToolTip="{l:T 'Package power reported by the RAPL energy meter'}">
                                    <TextBlock Text="{l:T 'Package power'}" Style="{StaticResource StatLabel}" />
                                    <TextBlock Text="{Binding CpuPower}" Style="{StaticResource StatValue}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Stat}" ToolTip="{l:T 'Threads waiting for CPU time (processor queue length)'}">
                                    <TextBlock Text="{l:T 'Run queue'}" Style="{StaticResource StatLabel}" />
                                    <TextBlock Text="{Binding CpuQueue}" Style="{StaticResource StatValue}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Stat}">
                                    <TextBlock Text="{l:T 'Uptime'}" Style="{StaticResource StatLabel}" />
                                    <TextBlock Text="{Binding Uptime}" Style="{StaticResource StatValue}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Stat}">
                                    <TextBlock Text="{l:T 'Base clock'}" Style="{StaticResource StatLabel}" />
                                    <TextBlock Text="{Binding CpuBaseClock}" Style="{StaticResource StatValue}" />
                                </StackPanel>
                            </c:AdaptiveGrid>
                        </Grid>

                        <DockPanel Margin="0,16,0,8">
                            <TextBlock Text="{l:T 'Load per logical processor'}" Style="{StaticResource Text.Overline}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CpuCounts}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Cores}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CoreLoad}">
                                    <Border Height="30" Margin="2" CornerRadius="6" Background="{Binding Value, Converter={StaticResource HeatBrush}}">
                                        <Border.ToolTip>
                                            <TextBlock><Run Text="{Binding Label, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Value, StringFormat={}{0:0}%, Mode=OneWay}" /></TextBlock>
                                        </Border.ToolTip>
                                        <TextBlock Text="{Binding Value, StringFormat={}{0:0}}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}" Opacity="0.85" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <c:AdaptiveGrid MinColumnWidth="480" MaxColumns="2" Gap="16" Margin="0,16,0,0">
                    <!-- GPU -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Border Style="{StaticResource CardIcon}" Background="{DynamicResource Brush.AccentSoft}">
                                    <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Chart.Gpu}" />
                                </Border>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding GpuUsage, StringFormat={}{0:0}%}" Style="{StaticResource Text.MetricSmall}" VerticalAlignment="Center" />
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{l:T 'Graphics'}" Style="{StaticResource Text.H2}" />
                                    <TextBlock Text="{Binding GpuName}" Style="{StaticResource Text.Caption}" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{l:T 'No GPU telemetry is available on this system.'}" Style="{StaticResource Text.Secondary}" Margin="0,20"
                                       Visibility="{Binding GpuAvailable, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" />
                            <StackPanel Visibility="{Binding GpuAvailable, Converter={StaticResource VisibleIf}}">
                                <c:AreaChart Height="110" Margin="0,16,0,0" Values="{Binding GpuHistory}" Maximum="100" Stroke="{DynamicResource Brush.Chart.Gpu}" Format="percent" SeriesName="GPU" />
                                <UniformGrid Columns="4" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{l:T 'Temperature'}" Style="{StaticResource StatLabel}" />
                                        <TextBlock Text="{Binding GpuTemperature}" Style="{StaticResource StatValue}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{l:T 'Core clock'}" Style="{StaticResource StatLabel}" />
                                        <TextBlock Text="{Binding GpuClock}" Style="{StaticResource StatValue}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{l:T 'Power'}" Style="{StaticResource StatLabel}" />
                                        <TextBlock Text="{Binding GpuPower}" Style="{StaticResource StatValue}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{l:T 'Fan'}" Style="{StaticResource StatLabel}" />
                                        <TextBlock Text="{Binding GpuFan}" Style="{StaticResource StatValue}" />
                                    </StackPanel>
                                </UniformGrid>
                                <DockPanel Margin="0,14,0,6">
                                    <TextBlock Text="{l:T 'Video memory'}" Style="{StaticResource StatLabel}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding GpuVram}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                                </DockPanel>
                                <ProgressBar Value="{Binding GpuVramPercent}" Foreground="{DynamicResource Brush.Chart.Gpu}" />
                                <TextBlock Margin="0,12,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap">
                                    <Run Text="{l:T 'Engines:'}" /> <Run Text="{Binding GpuEngines, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap">
                                    <Run Text="{l:T 'Throttle reasons:'}" /> <Run Text="{Binding GpuThrottle, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Margin="0,3,0,0" Text="{Binding OtherGpus}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Visibility="{Binding OtherGpus, Converter={StaticResource VisibleIf}}" />
                                <TextBlock Margin="0,3,0,0" Text="{Binding GpuSource}" Style="{StaticResource Text.Caption}" FontSize="10.5" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Memory -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Border Style="{StaticResource CardIcon}" Background="{DynamicResource Brush.SuccessSoft}">
                                    <TextBlock Text="&#xE964;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Chart.Ram}" />
                                </Border>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding MemPercent, StringFormat={}{0:0}%}" Style="{StaticResource Text.MetricSmall}" VerticalAlignment="Center" />
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{l:T 'Memory'}" Style="{StaticResource Text.H2}" />
                                    <TextBlock Text="{Binding MemModules}" Style="{StaticResource Text.Caption}" />
                                </StackPanel>
                            </DockPanel>
                            <c:AreaChart Height="110" Margin="0,16,0,0" Values="{Binding MemHistory}" Maximum="100" Stroke="{DynamicResource Brush.Chart.Ram}" Format="percent" SeriesName="RAM" />
                            <UniformGrid Columns="4" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="{l:T 'In use'}" Style="{StaticResource StatLabel}" />
                                    <TextBlock Text="{Binding MemUsed}" Style="{StaticResource StatValue}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{l:T 'Available'}" Style="{StaticResource StatLabel}" />
                                    <TextBlock Text="{Binding MemAvailable}" Style="{StaticResource StatValue}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{l:T 'Total'}" Style="{StaticResource StatLabel}" />
                                    <TextBlock Text="{Binding MemTotal}" Style="{StaticResource StatValue}" />
                                </StackPanel>
                                <StackPanel ToolTip="{l:T 'File cache held by the system (included in available memory)'}">
                                    <TextBlock Text="{l:T 'Cached'}" Style="{StaticResource StatLabel}" />
                                    <TextBlock Text="{Binding MemCached}" Style="{StaticResource StatValue}" />
                                </StackPanel>
                            </UniformGrid>
                            <DockPanel Margin="0,14,0,6" ToolTip="{l:T 'Committed virtual memory versus the commit limit (RAM + page file)'}">
                                <TextBlock Text="{l:T 'Committed memory'}" Style="{StaticResource StatLabel}" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding MemCommit}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                            </DockPanel>
                            <ProgressBar Value="{Binding MemCommitPercent}" Foreground="{Binding MemCommitPercent, Converter={StaticResource LoadBrush}, ConverterParameter=Brush.Chart.Ram}" />
                        </StackPanel>
                    </Border>

                    <!-- Storage -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Border Style="{StaticResource CardIcon}" Background="{DynamicResource Brush.WarningSoft}">
                                    <TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Chart.Disk}" />
                                </Border>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Padding="10,5" FontSize="12" Content="{l:T 'Analyze'}" c:Ui.Glyph="&#xE721;"
                                        Command="{Binding OpenCommand}" CommandParameter="Storage" VerticalAlignment="Center" />
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{l:T 'Storage'}" Style="{StaticResource Text.H2}" />
                                    <TextBlock Style="{StaticResource Text.Caption}"><Run Text="{l:T 'Read'}" /> <Run Text="{Binding DiskRead, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{l:T 'Write'}" /> <Run Text="{Binding DiskWrite, Mode=OneWay}" /></TextBlock>
                                </StackPanel>
                            </DockPanel>
                            <c:AreaChart Height="90" Margin="0,16,0,0" Values="{Binding DiskReadHistory}" Values2="{Binding DiskWriteHistory}" Stroke="{DynamicResource Brush.Chart.Disk}"
                                         Stroke2="{DynamicResource Brush.Chart.Tx}" Format="disk" SeriesName="R" Series2Name="W" />
                            <ItemsControl ItemsSource="{Binding Volumes}" Margin="0,14,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:VolumeItem}">
                                        <DockPanel Margin="0,6">
                                            <Border DockPanel.Dock="Left" Width="38" Height="30" CornerRadius="8" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="12,0,0,0">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Usage}" DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" />
                                                    <TextBlock FontSize="12.5"><Run Text="{Binding Label, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Format, Mode=OneWay}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11" /></TextBlock>
                                                </DockPanel>
                                                <ProgressBar Value="{Binding Percent}" Margin="0,6,0,0" Foreground="{Binding Percent, Converter={StaticResource LoadBrush}, ConverterParameter=Brush.Chart.Disk}" />
                                                <TextBlock Text="{Binding Free}" Style="{StaticResource Text.Caption}" FontSize="10.5" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,14,0,6">
                                <TextBlock Text="{l:T 'Physical disks · health and SMART'}" Style="{StaticResource Text.Overline}" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="26" Height="26" c:Ui.Glyph="&#xE72C;" HorizontalAlignment="Right" Command="{Binding RefreshDisksCommand}" ToolTip="{l:T 'Refresh'}" />
                            </DockPanel>
                            <ContentControl Style="{StaticResource Spinner}" HorizontalAlignment="Left" Visibility="{Binding LoadingDisks, Converter={StaticResource VisibleIf}}" />
                            <ItemsControl ItemsSource="{Binding PhysicalDisks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PhysicalDiskItem}">
                                        <Border Style="{StaticResource Panel.Inset}" Margin="0,3" Padding="12,9">
                                            <DockPanel>
                                                <ContentControl DockPanel.Dock="Right" Style="{StaticResource StatusPill}" Tag="{Binding Health}" Content="{Binding Health, Converter={StaticResource Tr}}" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" />
                                                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap">
                                                        <Run Text="{Binding Subtitle, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{l:T 'Temp'}" /> <Run Text="{Binding Temperature, Mode=OneWay}" /><Run Text="  ·  SMART " /><Run Text="{Binding Smart, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Extra}" Style="{StaticResource Text.Caption}" Visibility="{Binding Extra, Converter={StaticResource VisibleIf}}" />
                                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Caption}" FontSize="10.5" Foreground="{DynamicResource Brush.Warning}" Visibility="{Binding Note, Converter={StaticResource VisibleIf}}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Network -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Border Style="{StaticResource CardIcon}" Background="{DynamicResource Brush.InfoSoft}">
                                    <TextBlock Text="&#xE968;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Chart.Rx}" />
                                </Border>
                                <ContentControl DockPanel.Dock="Right" Style="{StaticResource StatusPill}" Tag="{Binding NetState}" Content="{Binding NetStateText}" />
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{l:T 'Network'}" Style="{StaticResource Text.H2}" />
                                    <TextBlock Style="{StaticResource Text.Caption}"><Run Text="{Binding Adapter, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding AdapterType, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding LinkSpeed, Mode=OneWay}" /></TextBlock>
                                </StackPanel>
                            </DockPanel>
                            <c:AreaChart Height="90" Margin="0,16,0,0" Values="{Binding RxHistory}" Values2="{Binding TxHistory}" Stroke="{DynamicResource Brush.Chart.Rx}"
                                         Stroke2="{DynamicResource Brush.Chart.Tx}" Format="net" SeriesName="↓" Series2Name="↑" />
                            <UniformGrid Columns="4" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{l:T 'Download'}" Style="{StaticResource StatLabel}" />
                                    <TextBlock Text="{Binding Rx}" Style="{StaticResource StatValue}" Foreground="{DynamicResource Brush.Chart.Rx}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{l:T 'Upload'}" Style="{StaticResource StatLabel}" />
                                    <TextBlock Text="{Binding Tx}" Style="{StaticResource StatValue}" Foreground="{DynamicResource Brush.Chart.Tx}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{l:T 'Local IP'}" Style="{StaticResource StatLabel}" />
                                    <TextBlock Text="{Binding LocalIp}" Style="{StaticResource StatValue}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{l:T 'Gateway'}" Style="{StaticResource StatLabel}" />
                                    <TextBlock Text="{Binding Gateway}" Style="{StaticResource StatValue}" />
                                </StackPanel>
                            </UniformGrid>
                            <DockPanel Margin="0,14,0,6">
                                <TextBlock Text="{l:T 'Latency'}" Style="{StaticResource StatLabel}" />
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right">
                                    <Run Text="{l:T 'Internet'}" /> <Run Text="{Binding Latency, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{l:T 'Router'}" /> <Run Text="{Binding GatewayLatency, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{l:T 'Loss'}" /> <Run Text="{Binding PacketLoss, Mode=OneWay}" />
                                </TextBlock>
                            </DockPanel>
                            <c:AreaChart Height="56" Values="{Binding LatencyHistory}" Stroke="{DynamicResource Brush.Chart.Latency}" Format="ms" ShowGrid="False" SeriesName="RTT" />
                        </StackPanel>
                    </Border>
                </c:AdaptiveGrid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
