<UserControl x:Class="PCCommandCenter.App.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PCCommandCenter.App.Controls"
             xmlns:l="clr-namespace:PCCommandCenter.App.Localization"
             xmlns:vm="clr-namespace:PCCommandCenter.App.ViewModels">
    <DockPanel Margin="28,4,28,24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBox Width="280" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" c:Ui.Glyph="&#xE721;" c:Ui.Placeholder="{l:T 'Search startup entries'}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource Btn.Ghost}" c:Ui.Glyph="&#xE8A7;" Content="{l:T 'Windows Startup settings'}" Command="{Binding OpenTaskManagerStartupCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource Btn.Secondary}" c:Ui.Glyph="&#xE72C;" Content="{l:T 'Refresh'}" Command="{Binding RefreshCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <ContentControl Style="{StaticResource StatusPill}" Tag="{x:Static c:Statuses.Good}" Margin="0,0,8,0">
                    <TextBlock><Run Text="{Binding EnabledCount, Mode=OneWay}" /> <Run Text="{l:T 'enabled'}" /></TextBlock>
                </ContentControl>
                <ContentControl Style="{StaticResource StatusPill}" Tag="{x:Null}">
                    <TextBlock><Run Text="{Binding DisabledCount, Mode=OneWay}" /> <Run Text="{l:T 'disabled'}" /></TextBlock>
                </ContentControl>
            </StackPanel>
        </DockPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource Panel.Inset}" Margin="0,0,0,14" Padding="14,10"
                Visibility="{Binding IsElevated, Converter={StaticResource VisibleIf}, ConverterParameter=invert}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Padding="10,5" FontSize="12" c:Ui.Glyph="&#xEA18;" Content="{l:T 'Restart as administrator'}" Command="{Binding RestartElevatedCommand}" />
                <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Info}" Margin="0,0,10,0" />
                <TextBlock Text="{l:T 'Entries for all users (HKLM and the common Startup folder) can only be changed when running as administrator.'}" Style="{StaticResource Text.Secondary}" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="6,4">
            <Grid>
                <DataGrid ItemsSource="{Binding View}" RowHeight="52">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{l:T 'Open file location'}" c:Ui.Glyph="&#xE838;" Command="{Binding OpenLocationCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{l:T 'Name'}" Width="1.6*" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:StartupItem}">
                                    <DockPanel>
                                        <Grid Width="28" Height="28" Margin="0,0,12,0">
                                            <Border CornerRadius="8" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
                                            <Image Source="{Binding Icon}" Width="18" Height="18" />
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Publisher}" Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:T 'Command / path'}" Width="2.4*" SortMemberPath="Command">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:StartupItem}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Command}" Style="{StaticResource Cell.Mono}" FontSize="11.5" ToolTip="{Binding Command}" />
                                        <TextBlock Text="{l:T 'File not found'}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Warning}" Visibility="{Binding Missing, Converter={StaticResource VisibleIf}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:T 'Location'}" Width="1.3*" SortMemberPath="Location">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:StartupItem}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Location}" Style="{StaticResource Cell.Muted}" />
                                        <TextBlock Text="{Binding Scope}" Style="{StaticResource Text.Caption}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:T 'Impact'}" Width="110">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="ToolTip" Value="{l:T 'Windows does not expose the startup impact measurement to other applications.'}" />
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:StartupItem}">
                                    <TextBlock Text="{Binding Impact}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:T 'Status'}" Width="140" SortMemberPath="Enabled">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:StartupItem}">
                                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Enabled}" IsEnabled="{Binding CanToggle}" HorizontalAlignment="Left" ToolTip="{Binding ToggleNote}"
                                              Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" Width="64" />
                                    </CheckBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <ContentControl Style="{StaticResource Spinner}" Width="28" Height="28" Visibility="{Binding IsBusy, Converter={StaticResource VisibleIf}}" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleIf}}" />
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
