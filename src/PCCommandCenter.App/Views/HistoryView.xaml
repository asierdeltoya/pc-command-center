<UserControl x:Class="PCCommandCenter.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PCCommandCenter.App.Controls"
             xmlns:l="clr-namespace:PCCommandCenter.App.Localization">
    <UserControl.Resources>
        <Style x:Key="ChartTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.H3}" />
        <Style x:Key="Stats" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="28,4,28,24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding Ranges}" SelectedItem="{Binding Range}">
                <ListBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{Binding Coverage}" Style="{StaticResource Text.Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center" Margin="16,0,0,0" />
        </DockPanel>

        <Grid>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Visibility="{Binding HasData, Converter={StaticResource VisibleIf}, ConverterParameter=invert}">
                <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="40" Foreground="{DynamicResource Brush.TextMuted}" />
                <TextBlock Text="{l:T 'Not enough history yet'}" Style="{StaticResource Text.H2}" HorizontalAlignment="Center" Margin="0,14,0,6" />
                <TextBlock Text="{l:T 'A point is saved every minute while the app runs. Keep it open or in the tray and the charts will fill up.'}"
                           Style="{StaticResource Text.Secondary}" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="None" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasData, Converter={StaticResource VisibleIf}}">
                <c:AdaptiveGrid MinColumnWidth="460" MaxColumns="2" Gap="16">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:T 'CPU usage'}" Style="{StaticResource ChartTitle}" />
                            <TextBlock Text="{Binding CpuStats}" Style="{StaticResource Stats}" />
                            <c:AreaChart Height="150" Margin="0,12,0,0" Values="{Binding Cpu}" Values2="{Binding CpuMax}" Times="{Binding Times}" Maximum="100" Format="percent"
                                         Stroke="{DynamicResource Brush.Chart.Cpu}" Stroke2="{DynamicResource Brush.Danger}" SeriesName="{l:T 'Average'}" Series2Name="{l:T 'Peak'}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:T 'Memory usage'}" Style="{StaticResource ChartTitle}" />
                            <TextBlock Text="{Binding RamStats}" Style="{StaticResource Stats}" />
                            <c:AreaChart Height="150" Margin="0,12,0,0" Values="{Binding Ram}" Times="{Binding Times}" Maximum="100" Format="percent" Stroke="{DynamicResource Brush.Chart.Ram}" SeriesName="RAM" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:T 'GPU usage'}" Style="{StaticResource ChartTitle}" />
                            <TextBlock Text="{Binding GpuStats}" Style="{StaticResource Stats}" />
                            <c:AreaChart Height="150" Margin="0,12,0,0" Values="{Binding Gpu}" Times="{Binding Times}" Maximum="100" Format="percent" Stroke="{DynamicResource Brush.Chart.Gpu}" SeriesName="GPU" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Visibility="{Binding HasTemps, Converter={StaticResource VisibleIf}}">
                        <StackPanel>
                            <TextBlock Text="{l:T 'Temperatures'}" Style="{StaticResource ChartTitle}" />
                            <TextBlock Text="{Binding TempStats}" Style="{StaticResource Stats}" />
                            <c:AreaChart Height="150" Margin="0,12,0,0" Values="{Binding CpuTemp}" Values2="{Binding GpuTemp}" Times="{Binding Times}" Format="temp"
                                         Stroke="{DynamicResource Brush.Chart.Cpu}" Stroke2="{DynamicResource Brush.Chart.Gpu}" SeriesName="CPU" Series2Name="GPU" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:T 'Disk activity'}" Style="{StaticResource ChartTitle}" />
                            <TextBlock Text="{Binding DiskStats}" Style="{StaticResource Stats}" />
                            <c:AreaChart Height="150" Margin="0,12,0,0" Values="{Binding DiskRead}" Values2="{Binding DiskWrite}" Times="{Binding Times}" Format="disk"
                                         Stroke="{DynamicResource Brush.Chart.Disk}" Stroke2="{DynamicResource Brush.Chart.Tx}" SeriesName="R" Series2Name="W" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:T 'Network traffic'}" Style="{StaticResource ChartTitle}" />
                            <TextBlock Text="{Binding NetStats}" Style="{StaticResource Stats}" />
                            <c:AreaChart Height="150" Margin="0,12,0,0" Values="{Binding NetRx}" Values2="{Binding NetTx}" Times="{Binding Times}" Format="net"
                                         Stroke="{DynamicResource Brush.Chart.Rx}" Stroke2="{DynamicResource Brush.Chart.Tx}" SeriesName="↓" Series2Name="↑" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:T 'Internet latency'}" Style="{StaticResource ChartTitle}" />
                            <TextBlock Text="{Binding LatencyStats}" Style="{StaticResource Stats}" />
                            <c:AreaChart Height="150" Margin="0,12,0,0" Values="{Binding Latency}" Times="{Binding Times}" Format="ms" Stroke="{DynamicResource Brush.Chart.Latency}" SeriesName="RTT" />
                        </StackPanel>
                    </Border>
                </c:AdaptiveGrid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
