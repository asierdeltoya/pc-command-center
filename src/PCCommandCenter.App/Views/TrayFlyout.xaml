<Window x:Class="PCCommandCenter.App.Views.TrayFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:PCCommandCenter.App.Controls"
        xmlns:l="clr-namespace:PCCommandCenter.App.Localization"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" SizeToContent="Height" Width="320" FontFamily="{StaticResource Font.UI}" FontSize="13"
        Foreground="{DynamicResource Brush.Text}">
    <Border Margin="12" CornerRadius="16" Background="{DynamicResource Brush.Elevated}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" Padding="18,16"
            Effect="{StaticResource Shadow.Popup}">
        <StackPanel>
            <DockPanel>
                <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource Brush.AccentGradient}">
                    <Image Source="pack://application:,,,/PCCommandCenter;component/Assets/logo.png" Width="18" Height="18" />
                </Border>
                <Border DockPanel.Dock="Right" x:Name="ScoreChip" Style="{StaticResource Chip}" Background="{DynamicResource Brush.AccentSoft}" BorderThickness="0">
                    <TextBlock x:Name="ScoreText" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" />
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="PC Command Center" FontWeight="SemiBold" />
                    <TextBlock x:Name="StateText" Style="{StaticResource Text.Caption}" />
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource Divider}" Margin="0,14,0,10" />

            <ItemsControl x:Name="Rows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,5">
                            <TextBlock Text="{Binding Label}" Width="64" Style="{StaticResource Text.Secondary}" FontSize="12" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Width="86" TextAlignment="Right" FontSize="12" FontWeight="SemiBold" />
                            <ProgressBar Value="{Binding Percent}" Height="5" Foreground="{Binding Brush}" VerticalAlignment="Center" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <UniformGrid Columns="3" Margin="0,14,0,0">
                <Button Style="{StaticResource Btn.Primary}" Content="{l:T 'Open'}" Click="Open_Click" Margin="0,0,6,0" Padding="8,7" FontSize="12" />
                <Button Style="{StaticResource Btn.Secondary}" Content="{l:T 'Diagnose'}" Click="Diagnose_Click" Margin="3,0" Padding="8,7" FontSize="12" />
                <Button Style="{StaticResource Btn.Secondary}" Content="{l:T 'Exit'}" Click="Exit_Click" Margin="6,0,0,0" Padding="8,7" FontSize="12" />
            </UniformGrid>
        </StackPanel>
    </Border>
</Window>
