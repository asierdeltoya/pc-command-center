<Window x:Class="PCCommandCenter.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:PCCommandCenter.App.Controls"
        xmlns:l="clr-namespace:PCCommandCenter.App.Localization"
        xmlns:vm="clr-namespace:PCCommandCenter.App.ViewModels"
        xmlns:svc="clr-namespace:PCCommandCenter.App.Services"
        Title="PC Command Center" Width="1360" Height="860" MinWidth="1000" MinHeight="680"
        Background="{DynamicResource Brush.Bg}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.UI}" FontSize="13" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        Icon="pack://application:,,,/PCCommandCenter;component/Assets/app.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="K" Modifiers="Ctrl" Command="{Binding OpenPaletteCommand}" />
        <KeyBinding Key="P" Modifiers="Ctrl+Shift" Command="{Binding OpenPaletteCommand}" />
        <KeyBinding Key="B" Modifiers="Ctrl" Command="{Binding ToggleSidebarCommand}" />
    </Window.InputBindings>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border x:Name="Sidebar" Width="240" Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0" ClipToBounds="True">
            <DockPanel Margin="12,0,12,12">
                <!-- Brand -->
                <Grid DockPanel.Dock="Top" Height="52" Margin="4,0,0,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource Brush.AccentGradient}">
                            <Image Source="pack://application:,,,/PCCommandCenter;component/Assets/logo.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel x:Name="BrandText" Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PC Command Center" FontSize="13.5" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Version}" Style="{StaticResource Text.Caption}" FontSize="10.5" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Search / palette -->
                <Button x:Name="SearchButton" DockPanel.Dock="Top" Command="{Binding OpenPaletteCommand}" Cursor="Hand" Margin="0,4,0,14" WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="{l:T 'Search everything (Ctrl+K)'}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Height="36" CornerRadius="9" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="11,0">
                                <DockPanel>
                                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Brush.TextMuted}" />
                                    <Border DockPanel.Dock="Right" CornerRadius="5" Padding="6,1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" VerticalAlignment="Center">
                                        <TextBlock Text="Ctrl K" FontSize="10.5" Foreground="{DynamicResource Brush.TextMuted}" />
                                    </Border>
                                    <TextBlock Text="{l:T 'Search…'}" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" />
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Footer: live status + elevation + collapse -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Style="{StaticResource Panel.Inset}" Padding="11,9" Margin="0,8,0,8" x:Name="StatusCard">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="CPU" Style="{StaticResource Text.Caption}" Width="34" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusCpu, StringFormat={}{0:0}%}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextSecondary}" Width="34" TextAlignment="Right" />
                                <ProgressBar Value="{Binding StatusCpu}" Height="4" Foreground="{DynamicResource Brush.Chart.Cpu}" VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel Margin="0,7,0,0">
                                <TextBlock Text="RAM" Style="{StaticResource Text.Caption}" Width="34" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusRam, StringFormat={}{0:0}%}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextSecondary}" Width="34" TextAlignment="Right" />
                                <ProgressBar Value="{Binding StatusRam}" Height="4" Foreground="{DynamicResource Brush.Chart.Ram}" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" c:Ui.Glyph="&#xE700;" Command="{Binding ToggleSidebarCommand}" ToolTip="{l:T 'Collapse sidebar (Ctrl+B)'}" />
                        <Grid>
                            <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" Background="{DynamicResource Brush.SuccessSoft}" BorderThickness="0"
                                    Visibility="{Binding IsElevated, Converter={StaticResource VisibleIf}}" x:Name="AdminChip">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource Brush.Success}" />
                                    <TextBlock Text="{l:T 'Administrator'}" Margin="6,0,0,0" FontSize="11" Foreground="{DynamicResource Brush.Success}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Left" Padding="8,6" FontSize="12" c:Ui.Glyph="&#xEA18;"
                                    Content="{l:T 'Run as admin'}" Command="{Binding RestartElevatedCommand}" x:Name="AdminButton"
                                    ToolTip="{l:T 'Restart elevated to unlock SMART data, services and system-wide startup entries'}"
                                    Visibility="{Binding IsElevated, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" />
                        </Grid>
                    </DockPanel>
                </StackPanel>

                <!-- Navigation -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding NavItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavItem}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Group, Converter={StaticResource Tr}}" Style="{StaticResource Text.Overline}" Margin="12,10,0,4"
                                               Visibility="{Binding StartsGroup, Converter={StaticResource VisibleIf}}" x:Name="GroupLabel" />
                                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                 Command="{Binding DataContext.NavigateItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                 c:Ui.Glyph="{Binding Glyph}" c:Ui.Badge="{Binding Badge}"
                                                 Content="{Binding Title, Converter={StaticResource Tr}}" ToolTip="{Binding Title, Converter={StaticResource Tr}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Margin="28,0,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource Btn.Icon}" c:Ui.Glyph="&#xE721;" Margin="0,14,4,0" Command="{Binding OpenPaletteCommand}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{l:T 'Search everything (Ctrl+K)'}" />
                    <Grid Margin="0,14,10,0">
                        <Button Style="{StaticResource Btn.Icon}" c:Ui.Glyph="&#xEA8F;" Command="{Binding ToggleNotificationsCommand}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{l:T 'Notifications'}" />
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" MinWidth="15" Height="15" CornerRadius="8" Background="{DynamicResource Brush.Danger}" IsHitTestVisible="False"
                                Visibility="{Binding Notifications.UnreadCount, Converter={StaticResource VisibleIf}}">
                            <TextBlock Text="{Binding Notifications.UnreadCount}" FontSize="9.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0" />
                        </Border>
                    </Grid>
                    <Border Width="1" Height="20" Background="{DynamicResource Brush.Border}" Margin="0,20,0,0" VerticalAlignment="Top" />
                    <Button Style="{StaticResource Btn.Chrome}" Content="&#xE921;" Click="Minimize_Click" ToolTip="{l:T 'Minimize'}" />
                    <Button Style="{StaticResource Btn.Chrome}" x:Name="MaxButton" Content="&#xE922;" Click="Maximize_Click" ToolTip="{l:T 'Maximize'}" />
                    <Button Style="{StaticResource Btn.ChromeClose}" Content="&#xE8BB;" Click="Close_Click" ToolTip="{l:T 'Close'}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="0,6,0,0">
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource Text.PageTitle}" />
                    <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Text.Secondary}" FontSize="12.5" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Page host -->
            <ContentControl x:Name="PageHost" Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="PageShift" />
                </ContentControl.RenderTransform>
            </ContentControl>
        </Grid>

        <!-- Toasts -->
        <ItemsControl Grid.ColumnSpan="2" ItemsSource="{Binding Notifications.Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,22" Width="360">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type svc:NotificationItem}">
                    <Border x:Name="Toast" Margin="0,8,0,0" CornerRadius="12" Background="{DynamicResource Brush.Elevated}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" Padding="14,12"
                            Effect="{StaticResource Shadow.Popup}" RenderTransformOrigin="1,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform X="0" />
                        </Border.RenderTransform>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="9" VerticalAlignment="Top" Background="{Binding Level, Converter={StaticResource StatusBrush}, ConverterParameter=soft}">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="14" Foreground="{Binding Level, Converter={StaticResource StatusBrush}}" />
                            </Border>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="24" Height="24" FontSize="9" c:Ui.Glyph="&#xE8BB;" VerticalAlignment="Top"
                                    Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                            <StackPanel Margin="12,0,6,0">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Visibility="{Binding Message, Converter={StaticResource VisibleIf}}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Toast" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" />
                                    <DoubleAnimation Storyboard.TargetName="Toast" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="40" To="0" Duration="0:0:0.28">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <DataTrigger Binding="{Binding IsLeaving}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Toast" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Toast" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="40" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Notification center -->
        <Grid Grid.ColumnSpan="2" Visibility="{Binding NotificationsOpen, Converter={StaticResource VisibleIf}}">
            <Border Background="Transparent" MouseDown="NotificationBackdrop_MouseDown" />
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,62,64,0" Width="380" MaxHeight="560" CornerRadius="14"
                    Background="{DynamicResource Brush.Elevated}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" Effect="{StaticResource Shadow.Popup}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="16,14,10,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Padding="8,4" FontSize="12" Content="{l:T 'Clear all'}" Command="{Binding ClearNotificationsCommand}" />
                        <TextBlock Text="{l:T 'Notifications'}" Style="{StaticResource Text.H2}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid>
                        <ContentControl Style="{StaticResource EmptyState}" c:Ui.Glyph="&#xEA8F;" Margin="0,10,0,30"
                                        Visibility="{Binding Notifications.Items.Count, Converter={StaticResource VisibleIf}, ConverterParameter=invert}">
                            <TextBlock Text="{l:T 'You are all caught up'}" Style="{StaticResource Text.Secondary}" />
                        </ContentControl>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Notifications.Items}" Margin="8,0,8,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type svc:NotificationItem}">
                                        <Border CornerRadius="10" Padding="10" Margin="0,2" Background="Transparent" x:Name="Bd">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Style="{StaticResource Icon}" VerticalAlignment="Top" Margin="2,2,12,0" FontSize="14" Foreground="{Binding Level, Converter={StaticResource StatusBrush}}" />
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="24" Height="24" FontSize="9" c:Ui.Glyph="&#xE8BB;" VerticalAlignment="Top" ToolTip="{l:T 'Dismiss'}"
                                                        Command="{Binding DataContext.DismissNotificationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="{Binding Message, Converter={StaticResource VisibleIf}}" />
                                                    <TextBlock Text="{Binding Time, StringFormat=t}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Command palette -->
        <Grid Grid.ColumnSpan="2" x:Name="PaletteLayer" DataContext="{Binding Palette}" Visibility="{Binding IsOpen, Converter={StaticResource VisibleIf}}">
            <Border Background="{DynamicResource Brush.Overlay}" MouseDown="PaletteBackdrop_MouseDown" />
            <Border x:Name="PalettePanel" Width="620" VerticalAlignment="Top" Margin="0,96,0,0" CornerRadius="16" Background="{DynamicResource Brush.Elevated}"
                    BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" Effect="{StaticResource Shadow.Popup}" RenderTransformOrigin="0.5,0">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="PaletteScale" ScaleX="1" ScaleY="1" />
                </Border.RenderTransform>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="18,14,18,12">
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="16" Foreground="{DynamicResource Brush.TextMuted}" />
                        <Border DockPanel.Dock="Right" CornerRadius="5" Padding="6,1" Background="{DynamicResource Brush.SurfaceAlt}" VerticalAlignment="Center">
                            <TextBlock Text="Esc" FontSize="10.5" Foreground="{DynamicResource Brush.TextMuted}" />
                        </Border>
                        <TextBox x:Name="PaletteInput" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" FontSize="15.5"
                                 Margin="8,0" Padding="4,4" c:Ui.Placeholder="{l:T 'Search everything...'}" PreviewKeyDown="PaletteInput_PreviewKeyDown" />
                    </DockPanel>
                    <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Brush.Border}" />
                    <DockPanel DockPanel.Dock="Bottom" Margin="18,8,18,10">
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{l:T '↑↓ to navigate · Enter to run · Esc to close'}" />
                    </DockPanel>
                    <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource Brush.Border}" />
                    <ListBox x:Name="PaletteList" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" Style="{StaticResource PlainList}" MaxHeight="420" Margin="8"
                             MouseUp="PaletteList_MouseUp">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PaletteCommand}">
                                <DockPanel Margin="10,8">
                                    <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="9" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="14" />
                                    </Border>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Group}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="10,0,4,0" />
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}" Margin="0,1,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Confirmation dialog -->
        <Grid Grid.ColumnSpan="2" DataContext="{Binding Dialogs.Current}" Visibility="{Binding Converter={StaticResource VisibleIf}}">
            <Border Background="{DynamicResource Brush.Overlay}" />
            <Border Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="16" Padding="24,22" Background="{DynamicResource Brush.Elevated}"
                    BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" Effect="{StaticResource Shadow.Popup}">
                <StackPanel>
                    <DockPanel>
                        <Border Width="42" Height="42" CornerRadius="12" VerticalAlignment="Top" Background="{Binding Kind, Converter={StaticResource StatusBrush}, ConverterParameter=soft}">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="19" Foreground="{Binding Kind, Converter={StaticResource StatusBrush}}" />
                        </Border>
                        <StackPanel Margin="16,0,0,0">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}" FontSize="16" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="19" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Panel.Inset}" Margin="58,14,0,0" Padding="10,8" Visibility="{Binding Details, Converter={StaticResource VisibleIf}}">
                        <TextBlock Text="{Binding Details}" Style="{StaticResource Text.Mono}" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </Border>
                    <CheckBox Margin="58,14,0,0" IsChecked="{Binding Acknowledged}" Visibility="{Binding HasAcknowledge, Converter={StaticResource VisibleIf}}">
                        <TextBlock Text="{Binding Acknowledge}" TextWrapping="Wrap" FontSize="12.5" />
                    </CheckBox>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Style="{StaticResource Btn.Secondary}" Content="{Binding CancelText}" Command="{Binding CancelCommand}" IsCancel="True" Margin="0,0,10,0" MinWidth="96" />
                        <Button x:Name="DialogConfirm" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" MinWidth="110">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- First-run welcome -->
        <Grid Grid.ColumnSpan="2" x:Name="WelcomeLayer" Background="{DynamicResource Brush.Bg}" Visibility="Collapsed">
            <Grid.Resources>
                <Style x:Key="Stage" TargetType="StackPanel">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Visibility" Value="Collapsed" />
                </Style>
            </Grid.Resources>
            <Border VerticalAlignment="Top" Height="52" Background="Transparent" />
            <Button Style="{StaticResource Btn.ChromeClose}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Close_Click" />

            <StackPanel x:Name="WelcomeIntro" Style="{StaticResource Stage}" Width="460">
                <Border Width="84" Height="84" CornerRadius="24" Background="{DynamicResource Brush.AccentGradient}" HorizontalAlignment="Center">
                    <Image Source="pack://application:,,,/PCCommandCenter;component/Assets/logo.png" Width="52" Height="52" />
                </Border>
                <TextBlock Text="PC COMMAND CENTER" HorizontalAlignment="Center" Margin="0,28,0,0" FontSize="28" FontWeight="Bold" FontFamily="{StaticResource Font.Display}" />
                <TextBlock Text="{l:T 'Your PC. One dashboard.'}" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="16" Style="{StaticResource Text.Secondary}" />
                <TextBlock Text="{l:T 'Real-time monitoring, diagnostics and tools for Windows. Everything you see is measured on this computer — nothing is simulated.'}"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,22,0,0" Style="{StaticResource Text.Caption}" FontSize="12.5" LineHeight="19" />
                <Button Style="{StaticResource Btn.Primary}" Content="{l:T 'Get started'}" HorizontalAlignment="Center" Margin="0,30,0,0" Padding="28,11" FontSize="14"
                        Command="{Binding StartWelcomeScanCommand}" />
                <Button Style="{StaticResource Btn.Link}" Content="{l:T 'Skip the initial scan'}" HorizontalAlignment="Center" Margin="0,16,0,0" Command="{Binding SkipWelcomeCommand}" />
            </StackPanel>

            <StackPanel x:Name="WelcomeScanning" Style="{StaticResource Stage}" Width="420">
                <Grid Width="120" Height="120" HorizontalAlignment="Center">
                    <c:RingGauge Value="{Binding WelcomeProgress, Converter={x:Static c:ProgressToPercent.Instance}}" Thickness="8" Stroke="{DynamicResource Brush.Accent}" />
                    <TextBlock Text="{Binding WelcomeProgress, StringFormat={}{0:P0}}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" FontWeight="SemiBold" />
                </Grid>
                <TextBlock Text="{l:T 'Scanning your system...'}" HorizontalAlignment="Center" Margin="0,28,0,0" Style="{StaticResource Text.H2}" FontSize="18" />
                <TextBlock Text="{Binding WelcomeStep}" HorizontalAlignment="Center" Margin="0,8,0,0" Style="{StaticResource Text.Secondary}" />
            </StackPanel>

            <StackPanel x:Name="WelcomeReady" Style="{StaticResource Stage}" Width="460">
                <Border Width="76" Height="76" CornerRadius="38" Background="{DynamicResource Brush.SuccessSoft}" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="32" Foreground="{DynamicResource Brush.Success}" />
                </Border>
                <TextBlock Text="{l:T 'Your system is ready.'}" HorizontalAlignment="Center" Margin="0,24,0,0" FontSize="24" FontWeight="SemiBold" FontFamily="{StaticResource Font.Display}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="{Binding WelcomeScore, Converter={StaticResource VisibleIf}}">
                    <TextBlock Text="{l:T 'Health score'}" Style="{StaticResource Text.Secondary}" FontSize="14" />
                    <TextBlock Text="{Binding WelcomeScore, StringFormat={}{0} / 100}" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0" Foreground="{DynamicResource Brush.Accent}" />
                </StackPanel>
                <TextBlock Text="{Binding WelcomeSummary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" Style="{StaticResource Text.Caption}" />
                <Button Style="{StaticResource Btn.Primary}" Content="{l:T 'Open dashboard'}" HorizontalAlignment="Center" Margin="0,28,0,0" Padding="28,11" FontSize="14" Command="{Binding FinishWelcomeCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
