<UserControl x:Class="PCCommandCenter.App.Views.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PCCommandCenter.App.Controls"
             xmlns:l="clr-namespace:PCCommandCenter.App.Localization"
             xmlns:vm="clr-namespace:PCCommandCenter.App.ViewModels">
    <DockPanel Margin="28,4,28,24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource Btn.Ghost}" c:Ui.Glyph="&#xE8C8;" Content="{l:T 'Copy Output'}" Command="{Binding CopyOutputCommand}" Margin="0,0,6,0" />
                <Button Style="{StaticResource Btn.Ghost}" c:Ui.Glyph="&#xE99A;" Content="{l:T 'Send to AI'}" Command="{Binding SendToAiCommand}" Margin="0,0,6,0" />
                <Button Style="{StaticResource Btn.Ghost}" c:Ui.Glyph="&#xE74D;" Content="{l:T 'Clear'}" Command="{Binding ClearCommand}" />
            </StackPanel>
            <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding Sessions}" SelectedItem="{Binding Current}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TerminalSession}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE756;" FontFamily="{StaticResource Font.Icons}" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{l:T 'Commands run as your user account. Commands that can modify the system ask for confirmation.'}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="16,0,0,0" />
        </DockPanel>

        <Border CornerRadius="12" Background="{DynamicResource Brush.Bg}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <DockPanel>
                <!-- Input line -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="14,10" Background="{DynamicResource Brush.Surface}" CornerRadius="0,0,12,12">
                    <DockPanel>
                        <Grid DockPanel.Dock="Right" Margin="10,0,0,0">
                            <Button Style="{StaticResource Btn.Primary}" c:Ui.Glyph="&#xE768;" Content="{l:T 'Run'}" Command="{Binding RunCommand}" Padding="14,6"
                                    Visibility="{Binding IsRunning, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" />
                            <Button Style="{StaticResource Btn.Danger}" c:Ui.Glyph="&#xE71A;" Content="{l:T 'Stop'}" Command="{Binding StopCommand}" Padding="14,6"
                                    Visibility="{Binding IsRunning, Converter={StaticResource VisibleIf}}" />
                        </Grid>
                        <TextBlock Text="{Binding Current.PromptPrefix}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" MaxWidth="420" />
                        <Border DockPanel.Dock="Top" Visibility="{Binding Current.InputFromAi, Converter={StaticResource VisibleIf}}" />
                        <Grid>
                            <TextBox x:Name="Input" Text="{Binding Current.Input, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Padding="8,4"
                                     FontFamily="{StaticResource Font.Mono}" FontSize="12.5" PreviewKeyDown="Input_PreviewKeyDown" c:Ui.Placeholder="{l:T 'Type a command and press Enter'}" />
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Chip}" Background="{DynamicResource Brush.WarningSoft}" BorderThickness="0"
                                    Visibility="{Binding Current.InputFromAi, Converter={StaticResource VisibleIf}}" ToolTip="{l:T 'Suggested by the AI — review before running'}">
                                <TextBlock Text="{l:T 'AI suggestion'}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Warning}" />
                            </Border>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Output blocks -->
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Current.Blocks.Count, Converter={StaticResource VisibleIf}, ConverterParameter=invert}">
                        <TextBlock Text="&#xE756;" Style="{StaticResource Icon}" FontSize="28" Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,12,0,0" HorizontalAlignment="Center">
                            <Run Text="{Binding Current.Title, Mode=OneWay}" /> <Run Text="{l:T 'is ready. Try'}" /> <Run Text="ipconfig /all" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Accent}" />
                            <Run Text="{l:T 'or'}" /> <Run Text="Get-NetAdapter" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Accent}" />
                        </TextBlock>
                        <TextBlock Text="{l:T '↑ / ↓ browse history · Ctrl+L clear · Esc stop'}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" c:Ui.AutoScrollTrigger="{Binding ScrollTick}" Padding="16,12">
                        <ItemsControl ItemsSource="{Binding Current.Blocks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CommandBlock}">
                                    <Border Margin="0,0,0,14" Padding="0,0,0,10" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Style="{StaticResource Btn.Icon}" Width="26" Height="26" FontSize="12" c:Ui.Glyph="&#xE72C;" ToolTip="{l:T 'Run again'}"
                                                            Command="{Binding DataContext.RerunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource Btn.Icon}" Width="26" Height="26" FontSize="12" c:Ui.Glyph="&#xE8C8;" ToolTip="{l:T 'Copy Output'}"
                                                            Command="{Binding DataContext.CopyOutputCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource Btn.Icon}" Width="26" Height="26" FontSize="12" c:Ui.Glyph="&#xE99A;" ToolTip="{l:T 'Send to AI'}"
                                                            Command="{Binding DataContext.SendToAiCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                </StackPanel>
                                                <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="12.5" TextWrapping="Wrap" TextTrimming="None">
                                                    <Run Text="{Binding Prompt, Mode=OneWay}" Foreground="{DynamicResource Brush.Accent}" /><Run Text="{Binding Command, Mode=OneWay}" FontWeight="SemiBold" />
                                                </TextBlock>
                                            </DockPanel>
                                            <TextBox Text="{Binding Stdout, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0,6,0,0"
                                                     FontFamily="{StaticResource Font.Mono}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}"
                                                     Visibility="{Binding HasStdout, Converter={StaticResource VisibleIf}}" />
                                            <Border Margin="0,6,0,0" Padding="10,6" CornerRadius="6" Background="{DynamicResource Brush.DangerSoft}" Visibility="{Binding HasStderr, Converter={StaticResource VisibleIf}}">
                                                <StackPanel>
                                                    <TextBlock Text="stderr" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Danger}" />
                                                    <TextBox Text="{Binding Stderr, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0,2,0,0"
                                                             FontFamily="{StaticResource Font.Mono}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Danger}" />
                                                </StackPanel>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <ContentControl Style="{StaticResource Spinner}" Width="12" Height="12" Margin="0,0,8,0" Visibility="{Binding IsRunning, Converter={StaticResource VisibleIf}}" />
                                                <Ellipse x:Name="Dot" Width="7" Height="7" Margin="0,0,8,0" Fill="{DynamicResource Brush.Danger}" Visibility="{Binding IsRunning, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" />
                                                <TextBlock Text="{Binding Footer}" Style="{StaticResource Text.Caption}" FontSize="11" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Succeeded}" Value="True">
                                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Success}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
