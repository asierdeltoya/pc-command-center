<UserControl x:Class="PCCommandCenter.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PCCommandCenter.App.Controls"
             xmlns:l="clr-namespace:PCCommandCenter.App.Localization"
             xmlns:vm="clr-namespace:PCCommandCenter.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,4,28,28" MaxWidth="900" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}" Padding="30,28">
                <DockPanel>
                    <Border Width="96" Height="96" CornerRadius="26" Background="{DynamicResource Brush.AccentGradient}" VerticalAlignment="Top">
                        <Image Source="pack://application:,,,/PCCommandCenter;component/Assets/logo.png" Width="60" Height="60" />
                    </Border>
                    <StackPanel Margin="26,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="28" FontWeight="Bold" FontFamily="{StaticResource Font.Display}" />
                        <TextBlock Text="{Binding Version}" Style="{StaticResource Text.Secondary}" FontSize="14" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Description}" FontSize="15" Margin="0,12,0,0" />
                        <TextBlock Text="{Binding Tagline}" Style="{StaticResource Text.Caption}" FontSize="13" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <c:AdaptiveGrid MinColumnWidth="400" MaxColumns="2" Gap="16" Margin="0,16,0,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:T 'Build information'}" Style="{StaticResource Text.H2}" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
                                    <Setter Property="FontSize" Value="12.5" />
                                    <Setter Property="Margin" Value="0,4" />
                                </Style>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:T 'Runtime'}" Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Text="{l:T 'Operating system'}" Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Text="{l:T 'Architecture'}" Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Text="{l:T 'Running as'}" Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Text="{l:T 'Executable'}" Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Text="{l:T 'Data folder'}" Foreground="{DynamicResource Brush.TextMuted}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Runtime}" />
                                <TextBlock Text="{Binding Os}" />
                                <TextBlock Text="{Binding Architecture}" />
                                <TextBlock Text="{Binding Privileges}" />
                                <TextBlock Text="{Binding Executable}" ToolTip="{Binding Executable}" />
                                <TextBlock Text="{Binding DataFolder}" ToolTip="{Binding DataFolder}" />
                            </StackPanel>
                        </Grid>
                        <Button Style="{StaticResource Btn.Secondary}" HorizontalAlignment="Left" Content="{l:T 'Open data folder'}" c:Ui.Glyph="&#xE838;" Command="{Binding OpenFolderCommand}" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:T 'Where the data comes from'}" Style="{StaticResource Text.H2}" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding DataSources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DataSource}">
                                    <DockPanel Margin="0,4">
                                        <TextBlock Text="{Binding Title, Converter={StaticResource Tr}}" Width="90" FontWeight="SemiBold" FontSize="12.5" />
                                        <TextBlock Text="{Binding Text, Converter={StaticResource Tr}}" Style="{StaticResource Text.Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </c:AdaptiveGrid>
            <TextBlock Text="© 2026 PC Command Center" Style="{StaticResource Text.Caption}" Margin="2,18,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
