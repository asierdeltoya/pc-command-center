<UserControl x:Class="PCCommandCenter.App.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PCCommandCenter.App.Controls"
             xmlns:l="clr-namespace:PCCommandCenter.App.Localization"
             xmlns:vm="clr-namespace:PCCommandCenter.App.ViewModels"
             xmlns:core="clr-namespace:PCCommandCenter.Core;assembly=PCCommandCenter.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,4,28,28">
            <!-- Drive picker -->
            <DockPanel Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource Btn.Ghost}" c:Ui.Glyph="&#xE72C;" Content="{l:T 'Refresh'}" Command="{Binding RefreshDrivesCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Btn.Secondary}" c:Ui.Glyph="&#xE838;" Content="{l:T 'Analyze a folder…'}" Command="{Binding ScanFolderCommand}" Margin="0,0,8,0" IsEnabled="{Binding IsScanning, Converter={StaticResource Not}}" />
                    <Button Style="{StaticResource Btn.Primary}" c:Ui.Glyph="&#xE721;" Content="{l:T 'Analyze drive'}" Command="{Binding ScanCommand}" IsEnabled="{Binding IsScanning, Converter={StaticResource Not}}" />
                </StackPanel>
                <TextBlock Text="{l:T 'Drives'}" Style="{StaticResource Text.H2}" VerticalAlignment="Center" />
            </DockPanel>
            <ListBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><c:AdaptiveGrid MinColumnWidth="230" MaxColumns="5" Gap="12" /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Style="{StaticResource Card}" Padding="14,12">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DriveItem}">
                        <DockPanel>
                            <Grid Width="46" Height="46">
                                <c:RingGauge Value="{Binding Percent}" Thickness="5" Stroke="{Binding Percent, Converter={StaticResource LoadBrush}, ConverterParameter=Brush.Chart.Disk}" />
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Usage}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                <TextBlock Style="{StaticResource Text.Caption}"><Run Text="{Binding Percent, Mode=OneWay, StringFormat={}{0:0}%}" /> <Run Text="{l:T 'used'}" /> · <Run Text="{Binding Info.Format, Mode=OneWay}" /></TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Scanning progress -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding IsScanning, Converter={StaticResource VisibleIf}}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Secondary}" Content="{l:T 'Cancel'}" Command="{Binding CancelScanCommand}" />
                        <ContentControl Style="{StaticResource Spinner}" Width="26" Height="26" />
                        <StackPanel Margin="14,0,0,0">
                            <TextBlock Style="{StaticResource Text.H3}"><Run Text="{l:T 'Analyzing'}" /> <Run Text="{Binding ScanRoot, Mode=OneWay}" /></TextBlock>
                            <TextBlock Style="{StaticResource Text.Caption}"><Run Text="{Binding ProgressFiles, Mode=OneWay}" /> · <Run Text="{Binding ProgressBytes, Mode=OneWay}" /> · <Run Text="{Binding ScanElapsed, Mode=OneWay}" /></TextBlock>
                        </StackPanel>
                    </DockPanel>
                    <ProgressBar IsIndeterminate="True" Margin="0,14,0,8" />
                    <TextBlock Text="{Binding ProgressPath}" Style="{StaticResource Text.Caption}" FontFamily="{StaticResource Font.Mono}" />
                </StackPanel>
            </Border>

            <!-- Empty state -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="30">
                <Border.Visibility>
                    <MultiBinding Converter="{x:Static c:AllFalseVisible.Instance}">
                        <Binding Path="HasResult" />
                        <Binding Path="IsScanning" />
                    </MultiBinding>
                </Border.Visibility>
                <ContentControl Style="{StaticResource EmptyState}" c:Ui.Glyph="&#xEDA2;">
                    <StackPanel>
                        <TextBlock Text="{l:T 'Find out what is using your disk space'}" Style="{StaticResource Text.H3}" HorizontalAlignment="Center" />
                        <TextBlock Text="{l:T 'Select a drive and press Analyze. Nothing is deleted without your confirmation.'}" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </ContentControl>
            </Border>

            <!-- Results -->
            <StackPanel Visibility="{Binding HasResult, Converter={StaticResource VisibleIf}}" Margin="0,16,0,0">
                <UniformGrid Columns="4">
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="16,12"><StackPanel><TextBlock Text="{l:T 'Used space'}" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding UsedSpace}" Style="{StaticResource Text.MetricSmall}" /></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="16,12"><StackPanel><TextBlock Text="{l:T 'Free space'}" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding FreeSpace}" Style="{StaticResource Text.MetricSmall}" Foreground="{DynamicResource Brush.Success}" /></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="16,12"><StackPanel><TextBlock Text="{l:T 'Scanned'}" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding ScannedSize}" Style="{StaticResource Text.MetricSmall}" /></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Padding="16,12"><StackPanel><TextBlock Text="{l:T 'Contents'}" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding FileCount}" Style="{StaticResource Text.H3}" Margin="0,3,0,0" /></StackPanel></Border>
                </UniformGrid>
                <TextBlock Margin="2,8,0,0" Style="{StaticResource Text.Caption}"><Run Text="{Binding ResultSummary, Mode=OneWay}" /> <Run Text="{Binding Inaccessible, Mode=OneWay}" Foreground="{DynamicResource Brush.Warning}" /></TextBlock>

                <!-- Treemap + folders -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Button Style="{StaticResource Btn.Icon}" c:Ui.Glyph="&#xE72B;" Command="{Binding UpCommand}" ToolTip="{l:T 'Up one level'}" Margin="0,0,8,0" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" c:Ui.Glyph="&#xE838;" Content="{l:T 'Open in Explorer'}" Command="{Binding RevealCommand}" CommandParameter="{Binding CurrentNode}" />
                            <ItemsControl ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type core:FolderNode}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource Btn.Link}" Content="{Binding Name}" FontSize="13" Foreground="{DynamicResource Brush.Text}"
                                                    Command="{Binding DataContext.OpenNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <TextBlock Text="  ›  " Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                        <c:TreeMap Height="300" Items="{Binding TreeMapItems}" ItemCommand="{Binding OpenNodeCommand}" />
                        <TextBlock Text="{l:T 'Click a block to drill down. Sizes include all subfolders.'}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <c:AdaptiveGrid MinColumnWidth="460" MaxColumns="2" Gap="14" Margin="0,14,0,0">
                    <!-- Largest folders -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:T 'Largest folders'}" Style="{StaticResource Text.H2}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Folders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FolderItem}">
                                        <Button Cursor="Hand" Command="{Binding DataContext.OpenNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" CornerRadius="8" Padding="8,7" Background="Transparent">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" FontWeight="SemiBold" />
                                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Brush.Chart.Disk}" Margin="0,0,9,0" />
                                                    <TextBlock Text="{Binding Name}" />
                                                </DockPanel>
                                                <DockPanel Margin="22,5,0,0">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Percent}" Style="{StaticResource Text.Caption}" Width="48" TextAlignment="Right" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Meta}" Style="{StaticResource Text.Caption}" Margin="0,0,10,0" />
                                                    <ProgressBar Value="{Binding Fraction, Converter={x:Static c:ProgressToPercent.Instance}}" Height="4" Foreground="{DynamicResource Brush.Chart.Disk}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Extensions -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:T 'Space by file type'}" Style="{StaticResource Text.H2}" Margin="0,0,0,10" />
                            <DockPanel>
                                <Grid Width="180" Height="180" VerticalAlignment="Top">
                                    <c:DonutChart Segments="{Binding ExtensionSegments}" Thickness="22" />
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock Text="{Binding ScannedSize}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Text="{l:T 'analyzed'}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Extensions}" Margin="20,0,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ExtensionItem}">
                                            <DockPanel Margin="0,4">
                                                <Ellipse Width="9" Height="9" Fill="{Binding Brush}" Margin="0,0,10,0" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Percent}" Style="{StaticResource Text.Caption}" Width="46" TextAlignment="Right" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" FontWeight="SemiBold" Width="76" TextAlignment="Right" />
                                                <TextBlock><Run Text="{Binding Name, Mode=OneWay}" /> <Run Text="{Binding Count, Mode=OneWay}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11" /></TextBlock>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </c:AdaptiveGrid>

                <!-- Largest files -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="{l:T 'Largest files'}" Style="{StaticResource Text.H2}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Files}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FileItem}">
                                    <Border x:Name="Row" CornerRadius="8" Padding="8,6" Background="Transparent">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Modified}" Style="{StaticResource Text.Caption}" Width="80" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Size}" FontWeight="SemiBold" Width="80" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <Button Style="{StaticResource Btn.Icon}" Width="28" Height="28" c:Ui.Glyph="&#xE838;" ToolTip="{l:T 'Show in Explorer'}"
                                                        Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource Btn.Icon}" Width="28" Height="28" c:Ui.Glyph="&#xE74D;" ToolTip="{l:T 'Move to Recycle Bin…'}"
                                                        Command="{Binding DataContext.RecycleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,10,0" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" />
                                                <TextBlock Text="{Binding Folder}" Style="{StaticResource Text.Caption}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Cleanup -->
            <DockPanel Margin="2,24,0,12">
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" c:Ui.Glyph="&#xE72C;" Content="{l:T 'Recalculate'}" Command="{Binding LoadCleanupCommand}" />
                <TextBlock Text="{l:T 'Cleanup'}" Style="{StaticResource Text.H2}" VerticalAlignment="Center" />
                <TextBlock Text="{l:T 'Every cleanup asks for confirmation first.'}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                <ContentControl Style="{StaticResource Spinner}" Width="16" Height="16" Margin="12,0,0,0" HorizontalAlignment="Left" Visibility="{Binding LoadingCleanup, Converter={StaticResource VisibleIf}}" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Cleanup}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><c:AdaptiveGrid MinColumnWidth="320" MaxColumns="3" Gap="14" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CleanupItem}">
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <Button DockPanel.Dock="Bottom" Style="{StaticResource Btn.Secondary}" HorizontalAlignment="Left" Content="{l:T 'Clean…'}" c:Ui.Glyph="&#xE74D;" Margin="0,14,0,0"
                                        IsEnabled="{Binding CanClean}" Command="{Binding DataContext.CleanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" Style="{StaticResource Text.MetricSmall}" VerticalAlignment="Top" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.H3}" />
                                    <TextBlock Text="{Binding Items}" Style="{StaticResource Text.Caption}" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
