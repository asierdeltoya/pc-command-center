<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Accent (overridden at runtime by ThemeService) -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#4F5BD5" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#4552C4" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#3E49AE" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#1A4F5BD5" />
    <LinearGradientBrush x:Key="Brush.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4F5BD5" Offset="0" />
        <GradientStop Color="#A78BFA" Offset="1" />
    </LinearGradientBrush>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Brush.Bg" Color="#F3F5F9" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#ECEFF5" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#F3F5FA" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#F1F3F8" />
    <SolidColorBrush x:Key="Brush.SurfacePressed" Color="#E7EAF1" />
    <SolidColorBrush x:Key="Brush.Elevated" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Border" Color="#E2E6EE" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#CDD3DE" />
    <SolidColorBrush x:Key="Brush.Grid" Color="#EDF0F5" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="#801A2030" />
    <SolidColorBrush x:Key="Brush.Track" Color="#E4E8F0" />

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.Text" Color="#0E1320" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#4B5567" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#8A94A6" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF" />

    <!-- Status -->
    <SolidColorBrush x:Key="Brush.Success" Color="#059669" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#1A059669" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#D97706" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#1AD97706" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#DC2626" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#1ADC2626" />
    <SolidColorBrush x:Key="Brush.Info" Color="#2563EB" />
    <SolidColorBrush x:Key="Brush.InfoSoft" Color="#1A2563EB" />

    <!-- Charts -->
    <SolidColorBrush x:Key="Brush.Chart.Cpu" Color="#4F5BD5" />
    <SolidColorBrush x:Key="Brush.Chart.Gpu" Color="#9333EA" />
    <SolidColorBrush x:Key="Brush.Chart.Ram" Color="#059669" />
    <SolidColorBrush x:Key="Brush.Chart.Disk" Color="#D97706" />
    <SolidColorBrush x:Key="Brush.Chart.Rx" Color="#0284C7" />
    <SolidColorBrush x:Key="Brush.Chart.Tx" Color="#DB2777" />
    <SolidColorBrush x:Key="Brush.Chart.Latency" Color="#EA580C" />

    <Color x:Key="Color.Shadow">#1A2030</Color>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Shadow.Opacity">0.12</sys:Double>
</ResourceDictionary>
